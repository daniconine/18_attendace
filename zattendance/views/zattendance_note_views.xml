<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- Vista LIST -->
    <record id="view_zattendance_note_list" model="ir.ui.view">
        <field name="name">zattendance.note.list</field>
        <field name="model">zattendance.note</field>
        <field name="arch" type="xml">
            <list string="Mis Incidencias">
                <field name="create_date"/>
                <field name="zattendance_day_id"/>
                <field name="category"/>
                <field name="n_horas"/>
                <field name="reason"/>
                <field name="note"/>
                <field name="state"/>
                
            </list>
        </field>
    </record>

    <!-- Vista FORM -->
    <record id="view_zattendance_note_form" model="ir.ui.view">
        <field name="name">zattendance.note.form</field>
        <field name="model">zattendance.note</field>
        <field name="arch" type="xml">
            <form string="Justificación / Incidencia">
                <header>
                    <button name="action_approve" type="object" string="Aprobar"
                            class="btn-primary"
                            groups="zattendance.group_boss,zattendance.group_hr_manager"
                            invisible="state != 'submitted'"/>
                    <button name="action_reject" type="object" string="Rechazar"
                            class="btn-secondary"
                            groups="zattendance.group_boss,zattendance.group_hr_manager"
                            invisible="state != 'submitted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,approved,rejected"/>
                </header>

                <sheet>
                    <group>
                    <group string="Referencia">
                        <field name="zattendance_day_id" required="1"/>
                        <field name="requested_by" readonly="1"/>
                        
                    </group>
                    <group string="Clasificación">
                        <field name="category"/>
                        <field name="reason"/>
                        <field name="n_horas" widget="float_time"/>
                        <field name="approved_by" readonly="1" invisible="state == 'submitted'"/>
                        <field name="decision_date" readonly="1" invisible="state == 'submitted'"/>
                    </group>
                    </group>

                    <group string="Detalle / Sustento">
                    <field name="note" nolabel="1" placeholder="Describe el sustento y adjunta documentos si aplica..."/>
                    </group>

                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista PIVOT -->
    <record id="view_zattendance_note_pivot" model="ir.ui.view">
        <field name="name">zattendance.note.pivot</field>
        <field name="model">zattendance.note</field>
        <field name="arch" type="xml">
            <pivot string="Resumen de horas afectadas">
                <!-- FILAS -->
                
                <field name="create_date" type="row"/>
                <field name="reason" type="row"/>

                <!-- COLUMNAS (Aprobado / Enviada / Rechazada) -->
                <field name="state" type="col"/>

                <!-- TIEMPO (agrupable por mes/día en la UI) -->
                

                <!-- MEDIDA -->
                <field name="n_horas" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- =========================
        ACCIÓN: Mis notas
        ========================= -->
    <record id="action_zattendance_my_notes" model="ir.actions.act_window">
        <field name="name">Mis Justificaciones e Incidencias</field>
        <field name="res_model">zattendance.note</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="domain">[('zattendance_day_id.employee_id.user_id', '=', uid)]</field>

        <field name="views" eval="[
            (ref('view_zattendance_note_list'), 'list'),
            (ref('view_zattendance_note_form'), 'form'),
            (ref('view_zattendance_note_pivot'), 'pivot')
        ]"/>
    </record>

  </data>
</odoo>
