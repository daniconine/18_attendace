<odoo>
    <data>

        <record id="view_zattendance_report_wizard_form" model="ir.ui.view">
            <field name="name">zattendance.report.wizard.form</field>
            <field name="model">zattendance.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Reporte SUNAFIL">
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id"/>
                        </group>

                        <group>
                            <field name="employee_selection" widget="radio"/>
                            <field
                                name="employee_ids"
                                widget="many2many_tags"
                                invisible="employee_selection != 'specific'"
                            />
                        </group>
                    </group>

                    <footer>
                        <button
                            name="action_print_xlsx"
                            string="Generar Excel"
                            type="object"
                            class="btn-primary"
                        />
                        <button
                            string="Cancelar"
                            special="cancel"
                            class="btn-secondary"
                        />
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_zattendance_report_wizard" model="ir.actions.act_window">
            <field name="name">Reporte de Asistencia</field>
            <field name="res_model">zattendance.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <record id="action_report_zattendance_xlsx" model="ir.actions.report">
            <field name="name">Reporte de Asistencia</field>
            <field name="model">zattendance.report.wizard</field>
            <field name="report_type">xlsx</field>
            <field name="report_name">zattendance.report_zattendance_xlsx</field>
            <field name="report_file">reporte_asistencia_xlsx</field>
        </record>


        

    </data>
</odoo>