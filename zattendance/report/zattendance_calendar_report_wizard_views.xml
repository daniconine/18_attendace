<odoo>
    <data>

        <!-- Vista Wizard: Reporte General de Horarios -->
        <record id="view_zattendance_calendar_report_wizard_form" model="ir.ui.view">
            <field name="name">zattendance.calendar.report.wizard.form</field>
            <field name="model">zattendance.calendar.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Reporte General de Horarios">
                    <group>
                        <group>
                            <field name="company_id"/>
                        </group>

                        <group>
                            <field name="employee_selection" widget="radio"/>
                            <field
                                name="employee_ids"
                                widget="many2many_tags"
                                invisible="employee_selection != 'specific'"
                            />
                        </group>
                    </group>

                    <footer>
                        <button
                            name="action_print_calendar_xlsx"
                            string="Generar Excel"
                            type="object"
                            class="btn-primary"/>
                        <button
                            string="Cancelar"
                            special="cancel"
                            class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Acción del Wizard -->
        <record id="action_zattendance_calendar_report_wizard" model="ir.actions.act_window">
            <field name="name">Reporte General de Horarios</field>
            <field name="res_model">zattendance.calendar.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Acción XLSX -->
        <record id="action_report_zattendance_calendar_xlsx" model="ir.actions.report">
            <field name="name">Reporte General de Horarios</field>
            <field name="model">zattendance.calendar.report.wizard</field>
            <field name="report_type">xlsx</field>
            <field name="report_name">zattendance.report_calendar_xlsx</field>
            <field name="report_file">reporte_general_horarios_xlsx</field>
        </record>

                

    </data>
</odoo>