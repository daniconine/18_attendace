<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="email_template_vacation_year_completed" model="mail.template">
            <field name="name">Vacaciones: Periodo anual completado</field>
            <field name="model_id" ref="model_zleave_zvacation_year"/>

            <field name="subject">🎀🎗️🎗️🥈 Felicitaciones por un año más con nosotros - Periodo vacacional {{ object.display_name }}
            </field>

            <field name="email_from">
                {{ object.company_id.email or user.email_formatted or '' }}
            </field>

            <field name="email_to">
                {{ object.employee_email or '' }}
            </field>

            <field name="email_cc">
                {{ ctx.get('vacation_cc_emails', '') }}
            </field>

            <field name="auto_delete" eval="False"/>

            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #222;">

                    <p>
                        Estimado(a) <strong><t t-out="object.employee_id.name"/></strong>,
                    </p>

                    <p>
                        Queremos felicitarte por cumplir un año más trabajando con nosotros 🫠​.
                        La empresa agradece sinceramente tu compromiso, esfuerzo y aporte durante este periodo.
                    </p>

                    <p>
                        Asimismo, te informamos que se ha generado un periodo completo de vacaciones
                        correspondiente al ciclo <strong><t t-out="object.year"/></strong>.
                    </p>

                    <table style="border-collapse: collapse; width: 100%; margin: 14px 0;">
                        <tr>
                            <td style="border: 1px solid #ddd; padding: 8px;"><strong>Fecha inicial</strong></td>
                            <td style="border: 1px solid #ddd; padding: 8px;">
                                <t t-out="object.start_date"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid #ddd; padding: 8px;"><strong>Fecha final</strong></td>
                            <td style="border: 1px solid #ddd; padding: 8px;">
                                <t t-out="object.end_date"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid #ddd; padding: 8px;"><strong>Días acumulados</strong></td>
                            <td style="border: 1px solid #ddd; padding: 8px;">
                                <t t-out="'%.2f' % object.accumulated_days"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid #ddd; padding: 8px;"><strong>Días consumidos / adelantados</strong></td>
                            <td style="border: 1px solid #ddd; padding: 8px;">
                                <t t-out="'%.2f' % object.consumed_days"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid #ddd; padding: 8px;"><strong>Saldo disponible</strong></td>
                            <td style="border: 1px solid #ddd; padding: 8px;">
                                <strong><t t-out="'%.2f' % object.balance_days"/></strong>
                            </td>
                        </tr>
                       
                    </table>

                    <t t-if="object.consumed_days">
                        <p>
                            Los días consumidos mostrados en el resumen corresponden a vacaciones
                            utilizadas o adelantadas durante el periodo.
                        </p>
                    </t>

                    <p>
                        Te recordamos las principales reglas para el uso correcto de tus vacaciones:
                    </p>

                    <ul>
                        <li>
                            Puedes dividir tus 30 días de vacaciones, pero el primer bloque
                            no puede ser menor a <strong>15 días calendario</strong>.
                        </li>
                        <li>
                            El resto de tus días puede dividirse en fracciones más pequeñas, 5 dias consecutivos,
                            3 dias consecutivos, incluso de <strong>un solo día</strong>.
                        </li>
                        <li>
                            Puedes pedir adelanto de vacaciones antes de cumplir el año,
                            pero solo por los días que ya hayas acumulado proporcionalmente.
                        </li>
                    </ul>

                    <p>
                        Copiamos a tu jefe directo y al equipo de Recursos Humanos para que puedan
                        revisar la información, brindar su conformidad y continuar con la creación
                        del siguiente periodo vacacional.
                    </p>

                    <p>
                        Si identificas alguna diferencia en el resumen, por favor comunícate con
                        Recursos Humanos para la revisión correspondiente.
                    </p>

                    <p>
                        Cordialmente,<br/>
                        <strong>Recursos Humanos</strong><br/>
                        <t t-out="object.company_id.name"/>
                    </p>

                </div>
            </field>
        </record>

    </data>
</odoo>