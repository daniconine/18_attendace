<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de Lista para la Acumulación de Vacaciones Anual -->
    <record id="view_zvacation_year_list" model="ir.ui.view">
        <field name="name">zleave.zvacation.year.list</field>
        <field name="model">zleave.zvacation.year</field>
        <field name="arch" type="xml">
            <list string="Acumulación de Vacaciones">
                <field name="employee_id"/>
                <field name="year"/>
                <field name="accumulated_days" sum="Total Acumulado"/>
                <field name="consumed_days" sum="Total Consumido"/>
                <field name="balance_days" sum="Saldo Total"/>
                <field name="state" widget="badge" decoration-info="state == 'accrual'" decoration-success="state == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_zvacation_year_form" model="ir.ui.view">
        <field name="name">zleave.zvacation.year.form</field>
        <field name="model">zleave.zvacation.year</field>
        <field name="arch" type="xml">

            <form string="Acumulación de Vacaciones">
                 <!-- HEADER -->
                <header>

                    <field name="state" widget="statusbar"
                           statusbar_visible="accrual,closed"/>

                    <!-- Botón actualizar -->
                    <button name="action_update_accrual"
                            type="object"
                            string="Actualizar"
                            class="btn-primary"
                            invisible="state == 'closed'"/>

                    <!-- Botón cerrar -->
                    <button name="action_close_accrual"
                            type="object"
                            string="Cerrar"
                            class="btn-danger"
                            confirm="¿Está seguro de cerrar la acumulación anual? Esta acción no se puede deshacer."
                            modifiers="{'invisible': [['state', '=', 'closed']]}"/>

                </header>    

                <sheet>

                    <!-- TÍTULO -->
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>

                    <hr/>

                    <!-- GRUPO PRINCIPAL -->
                    <group>
                        <group string ="Datos">
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="employee_id" />                            
                            <field name="start_date"/>
                            <field name="has_advance" widget="boolean_toggle"/>
                            <field name="advance_days" invisible="not has_advance"/>
                            <field name="has_discounts" widget="boolean_toggle"/>
                            <field name="days_not_work" invisible="not has_discounts"/>
                            
                        </group>

                        <group string="Acumulación del Periodo Año">
                            <field name="year" />
                            <field name="end_date" readonly="1"/>                             
                            <field name="working_days_per_week" readonly="1"/>
                            <field name="min_effective_days" readonly="1"/>
                            <separator string="Plazos de Goce Legal"/>
                            <field name="enjoyment_deadline" 
                                    widget="remaining_days" 
                                    string="Límite para Tomarlas"
                                    decoration-danger="enjoyment_deadline &lt;= context_today()"
                                    decoration-warning="enjoyment_deadline &lt;= (context_today() + datetime.timedelta(days=60))"/>
                            <p class="text-muted">
                                * El trabajador debe gozar sus vacaciones antes de esta fecha para evitar indemnización.
                            </p>            
                            <separator string="Cálculo de Tramo de Acumulación"/>
                            <field name="start_date_call" readonly="1"/>
                            <field name="end_date_call" readonly="1"/>
                            <separator string="Resumen Acumulación"/>
                            <field name="accumulated_days" readonly="1"/>
                            <field name="consumed_days"/>
                            <field name="balance_days" readonly="1"/>
                            
                        </group>
                    </group>

                    <div colspan="2" style="height: 40px;"/>

                    <!-- ASIGNACIONES -->
                    <notebook>
                        <page string="Solicitudes de Vacaciones FIFO">
                            <field name="allocation_ids" readonly="1">
                                <list>
                                    <field name="vacation_id"/>
                                    <field name="state"/>
                                    <field name="days_allocated"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>

                <!-- CHATTER -->
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                    <field name="activity_ids"/>
                </chatter>

            </form>

        </field>
    </record>


    <!-- Acción para acceder a la acumulación de vacaciones -->
    <record id="view_zvacation_year_search" model="ir.ui.view">
        <field name="name">zleave.zvacation.year.search</field>
        <field name="model">zleave.zvacation.year</field>
        <field name="arch" type="xml">
            <search string="Buscar Acumulación">
                <field name="employee_id"/>
                <field name="year"/>
                <separator/>
                <filter string="Acumulando" name="state_accrual" domain="[('state', '=', 'accrual')]"/>
                <filter string="Cerrado" name="state_closed" domain="[('state', '=', 'closed')]"/>
                
                <group expand="0" string="Agrupar Por">
                    <filter string="Empleado" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Año" name="group_by_year" context="{'group_by': 'year'}"/>
                    <filter string="Estado" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_zvacation_year" model="ir.actions.act_window">
        <field name="name">Acumulación de Vacaciones Anual</field>
        <field name="res_model">zleave.zvacation.year</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
        <field name="context">{'search_default_group_by_employee': 1}</field>
        <field name="search_view_id" ref="view_zvacation_year_search"/>
    </record>


</odoo>
