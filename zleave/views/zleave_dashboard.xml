<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="dash_permisos" model="zleave.dashboard">
            <field name="name">Mis Licencias</field>
            <field name="description">Solicita licencia con o sin goce de haber.</field>
            <field name="icon">fa-calendar-check-o</field>
            <field name="action_id" ref="zleave.action_zleave_permission_my"/>
        </record>

        <record id="dash_vacaciones" model="zleave.dashboard">
            <field name="name">Mis Vacaciones</field>
            <field name="description">Gestiona tus días de descanso y saldos.</field>
            <field name="icon">fa-plane</field>
            <field name="action_id" ref="zleave.action_zvacation_my"/>
        </record>

        <record id="dash_horas_extras" model="zleave.dashboard">
            <field name="name">Mis Horas Extras a Pagar</field>
            <field name="description">Registro de sobretiempo pendiente a pagar.</field>
            <field name="icon">fa-clock-o</field>
            <field name="action_id" ref="zleave.action_zleave_overtime_my"/>
        </record>

        <record id="dash_mng_permisos" model="zleave.dashboard">
            <field name="name">Aprobar Solicitud de Licencias</field>
            <field name="description">Revisa las solicitudes de tu equipo.</field>
            <field name="icon">fa-wheelchair</field>
            <field name="action_id" ref="zleave.action_zleave_permission"/> 
            
        </record>

        <record id="dash_mng_vacaciones" model="zleave.dashboard">
            <field name="name">Aprobar Solicitud de Vacaciones</field>
            <field name="description">Revisa las solicitudes de tu equipo.</field>
            <field name="icon">fa-bed</field>
            <field name="action_id" ref="zleave.action_zvacation"/> 
        </record>

        <record id="dash_mng_horas_extras" model="zleave.dashboard">
            <field name="name">Aprobar Solicitud de Horas Extras</field>
            <field name="description">Revisa las solicitudes de tu equipo.</field>
            <field name="icon">fa-user-plus</field>
            <field name="action_id" ref="zleave.action_zleave_overtime"/> 
        </record>

    </data>
</odoo>