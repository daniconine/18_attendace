<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Definición de la plantilla de correo para la solicitud de permiso -->
    <record id="zleave.email_template_zleave_permission" model="mail.template">
        <field name="name">Notificación de Solicitud de Ausencia</field>
         <!-- Correo del usuario actual -->
        <field name="email_from">"Notificaciones Sistema ERP" &lt;odoo18@gerens.pe&gt;</field>
        
        <field name="reply_to">${'object.employee_id.work_email'}</field> <!-- No se permiten respuestas -->
        <field name="subject">Solicitud de Licencia N° {{ object.name }} enviada por {{ object.create_uid.name }}</field> <!-- Nombre del creador -->
        <field name="body_html">
            <![CDATA[
                <p>Estimado/a <t t-out="object.employee_id.parent_id.display_name"/> ,</p>
                <p>Se ha generado una solicitud de licencia para el trabajador <t t-out="object.employee_id.name"/>.</p>
                <p>Detalles de la Solicitud de Licencia:</p>
                <ul>
                    <li><strong>N°:</strong> <t t-out="object.name"/></li>
                    <li><strong>Referencia:</strong> <t t-out="object.display_name"/></li>
                    <li><strong>Fecha de solicitud:</strong> <t t-out="object.create_date"/></li>
                    <li><strong>Total de Días:</strong> <t t-out="object.duration_days"/></li>
                    <li><strong>Descripción:</strong> <t t-out="object.description"/></li>
                </ul>
                <p>Puede revisar y aprobar la solicitud de licencia haciendo clic en el siguiente enlace:</p>
                
                <p>
                    <a t-att-href="object.action_url" style="background-color: #4CAF50; color: white; padding: 12px 20px; text-align: center; text-decoration: none; display: inline-block; font-size: 16px; border-radius: 5px; cursor: pointer;">
                        Revisar y aprobar la solicitud de licencia
                    </a>
                </p>

                <br/>

                <p>Saludos</p>
                <p style="color: red; font-weight: bold;">Por favor, no responda a este correo ya que es una notificación automática del sistema.</p>

            ]]>
        </field>
        <field name="model_id" ref="zleave.model_zleave_permission"/>
    </record>

    
    <!-- Plantilla universal para aprobación, rechazo o anulación de licencia -->
    <record id="email_template_zleave_permission_status" model="mail.template">
        <field name="name">Notificación de Cambio de Estado de Licencia</field>

        <field name="model_id" ref="zleave.model_zleave_permission"/>

        <field name="email_from">"Notificaciones Sistema ERP" &lt;odoo18@gerens.pe&gt;</field>

        <!-- No permitir respuestas al trabajador ni al aprobador -->
        <field name="reply_to">"Notificaciones Sistema ERP" &lt;odoo18@gerens.pe&gt;</field>

        <field name="subject">Solicitud de Licencia N° {{ object.name }} {{ ctx.get('status_label') or 'actualizada' }}</field>

        <field name="body_html">
            <![CDATA[
                <p>Estimado/a,</p>

                <p><t t-set="status_label" t-value="ctx.get('status_label') or 'actualizada'"/></p>

                    <p>
                        La solicitud <strong><t t-out="object.name"/></strong>
                        del trabajador <strong><t t-out="object.employee_id.name"/></strong>
                        ha sido

                        <t t-if="status_label == 'aprobada'">
                            <strong style="color: green; font-weight: bold;">
                                <t t-out="status_label"/>
                            </strong>
                        </t>

                        <t t-elif="status_label == 'rechazada'">
                            <strong style="color: red; font-weight: bold;">
                                <t t-out="status_label"/>
                            </strong>
                        </t>

                        <t t-else="">
                            <span>
                                <t t-out="status_label"/>
                            </span>
                        </t>.
                    </p>
                

                    <li>
                        <strong>Empresa:</strong>
                        <t t-out="object.employee_id.company_id.name"/>
                    </li>

                <p>
                    <strong>Acción realizada por:</strong>
                    <t t-out="ctx.get('action_user_name') or object.write_uid.name"/>
                </p>

                <p>
                    <strong>Fecha de acción:</strong>
                    <t t-out="ctx.get('action_date') or object.write_date"/>
                </p>
                              
                <p>Saludos,</p>

            ]]>
        </field>
    </record>


     <!-- ########################################################################## -->
    <!-- Definición de la plantilla de correo para la solicitud de pvaaccionessss -->
    <record id="zleave.email_template_zleave_vacation" model="mail.template">
        <field name="name">Notificación de Solicitud de Vacaciones</field>
        <field name="email_from">${'odoo18@gerens.pe'}</field>
        <field name="reply_to">${object.employee_id.work_email or ''}</field>
        <field name="subject">Solicitud de Vacaciones N° {{ object.name }}  enviada por {{ object.create_uid.name }}</field>
        
        <field name="body_html">
            <![CDATA[
                <p>Estimado/a 
                    <t t-out="(object.employee_id.parent_id and object.employee_id.parent_id.display_name) or (object.approver_id and object.approver_id.name) or ''"/> ,
                </p>

                <p>Se ha generado una solicitud de vacaciones para el trabajador <t t-out="object.employee_id.name"/>.</p>

                <p><strong>Detalles de la solicitud:</strong></p>
                <ul>
                    <li><strong>N°:</strong> <t t-out="object.name"/></li>
                    <li><strong>Referencia:</strong> <t t-out="object.display_name"/></li>
                    <li><strong>Fecha de solicitud:</strong> <t t-out="object.create_date"/></li>
                    <li><strong>Rango:</strong> <t t-out="object.date_from"/> → <t t-out="object.date_to"/></li>
                    <li><strong>Total de días:</strong> <t t-out="object.duration_days"/></li>
                    <li><strong>Descripcion:</strong> <t t-out="object.description"/></li>
                </ul>

                <p>Puede revisar y aprobar la solicitud ingresando al sistema.</p>

                <p>
                    <a t-att-href="object.action_url" style="background-color: #4763b9; color: white; padding: 12px 20px; text-align: center; text-decoration: none; display: inline-block; font-size: 16px; border-radius: 5px; cursor: pointer;">
                        Revisar y aprobar la solicitud de Vacaciones
                    </a>
                </p>
                <br/>

                <p>Saludos</p>
                <p style="color: red; font-weight: bold;">
                    Por favor, no responda a este correo ya que es una notificación automática del sistema.
                </p>
            ]]>
        </field>
        <field name="model_id" ref="zleave.model_zleave_zvacation"/>
    </record>

