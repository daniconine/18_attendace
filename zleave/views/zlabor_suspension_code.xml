<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="view_zlabor_suspension_list" model="ir.ui.view">
        <field name="name">zlabor.suspension.list</field>
        <field name="model">zlabor.suspension.code</field>
        <field name="arch" type="xml">
            <list string="Códigos de Suspensión Laboral">
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <field name="type_suspension"/>
                <field name="asumido_por"/>
                <field name="visible_in_permission"/>
            </list>
        </field>
    </record>

    <record id="view_zlabor_suspension_form" model="ir.ui.view">
        <field name="name">zlabor.suspension.form</field>
        <field name="model">zlabor.suspension.code</field>
        <field name="arch" type="xml">
            <form string="Código de Suspensión Laboral">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="description"/>
                        <field name="type_suspension"/>
                        <field name="asumido_por"/>
                        <field name="visible_in_permission"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--#Actiobn-->
    <record id="action_zlabor_suspension_code" model="ir.actions.act_window">
        <field name="name">Códigos de Suspensión Laboral</field>
        <field name="res_model">zlabor.suspension.code</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea los códigos de suspensión laboral que se usarán en las solicitudes.
            </p>
        </field>
    </record>

  </data>
</odoo>