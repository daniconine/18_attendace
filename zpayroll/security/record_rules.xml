<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- RRHH Usuario: solo ve registros de las compañías permitidas -->
    <record id="rule_zemployee_extension_hr_user_company" model="ir.rule">
        <field name="name">ZEmployee Extension: RRHH usuario por compañía</field>
        <field name="model_id" ref="model_zemployee_extension"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- RRHH Manager: ve registros de las compañías permitidas y puede eliminar -->
    <record id="rule_zemployee_extension_hr_manager_company" model="ir.rule">
        <field name="name">ZEmployee Extension: RRHH manager por compañía</field>
        <field name="model_id" ref="model_zemployee_extension"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

</odoo>