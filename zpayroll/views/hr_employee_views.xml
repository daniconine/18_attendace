<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="view_employee_form_inherit_zemployee_extension" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.zemployee.extension</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='personal_information']//field[@name='marital']" position="after">
                <field name="zemployee_extension_id" readonly="1" options="{'no_create': True}"/>

                <button name="action_open_zemployee_extension_popup"
                        type="object"
                        string="Abrir (Extensión Normativa Peruana)"
                        class="btn-link"
                        invisible="not zemployee_extension_id"/>
            </xpath>

            <xpath expr="//field[@name='children']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='bank_account_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

</odoo>