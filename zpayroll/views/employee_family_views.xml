<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST -->
    <record id="view_employee_family_list" model="ir.ui.view">
        <field name="name">employee.family.list</field>
        <field name="model">employee.family</field>
        <field name="arch" type="xml">
            <list string="Familiares">
                <field name="zemployee_extension_id"/>
                <field name="name"/>
                <field name="relationship"/>
                <field name="birth_date"/>
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_employee_family_form" model="ir.ui.view">
        <field name="name">employee.family.form</field>
        <field name="model">employee.family</field>
        <field name="arch" type="xml">
            <form string="Familiar">
                <sheet>
                    <group>
                        <field name="zemployee_extension_id"/>
                        <field name="name"/>
                        <field name="relationship"/>
                        <field name="birth_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_employee_family" model="ir.actions.act_window">
        <field name="name">Familiares</field>
        <field name="res_model">employee.family</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>