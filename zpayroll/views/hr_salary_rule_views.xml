<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_salary_rule_form_inherit_flags" model="ir.ui.view">
            <field name="name">hr.salary.rule.form.inherit.flags</field>
            <field name="model">hr.salary.rule</field>
            <field name="inherit_id" ref="hr_payroll_community.hr_salary_rule_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Parámetros Perú">
                        <group col="2">
                            <field name="is_remunerative"/>
                            <field name="is_taxable_r5"/>
                            <field name="is_r5_projection_base"/>
                            <field name="is_asegurable"/>
                            <field name="is_computable"/>
                            <field name="is_variable"/>
                            <field name="is_non_taxable"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>