<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST -->
    <record id="view_hr_afp_rate_list" model="ir.ui.view">
        <field name="name">hr.afp.rate.list</field>
        <field name="model">hr.afp.rate</field>
        <field name="arch" type="xml">
            <list string="Tasas AFP">
                <field name="afp_id"/>
                <field name="date_from"/>
                <field name="mandatory_contribution_rate"/>
                <field name="insurance_premium_rate"/>
                <field name="commission_rate"/>
                
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_hr_afp_rate_form" model="ir.ui.view">
        <field name="name">hr.afp.rate.form</field>
        <field name="model">hr.afp.rate</field>
        <field name="arch" type="xml">
            <form string="Tasa AFP">
                <sheet>
                    <group>
                        <field name="afp_id"/>
                        <field name="date_from"/>
                        <field name="mandatory_contribution_rate"/>
                        <field name="insurance_premium_rate"/>
                        <field name="commission_rate"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_hr_afp_rate" model="ir.actions.act_window">
        <field name="name">Tasas AFP</field>
        <field name="res_model">hr.afp.rate</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>