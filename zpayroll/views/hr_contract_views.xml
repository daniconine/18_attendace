<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_contract_view_form_extension" model="ir.ui.view">
            <field name="name">hr.contract.form.extension</field>
            <field name="model">hr.contract</field>
            <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='salary']" position="inside">
                    <field name="code"/>
                    <field name="hours_per_day"/>
                    <field name="hours_per_month"/>
                    <field name="cost_per_hour_month"/>
                    <field name="hours_per_week"/>
                    <field name="bono_fijo_computable_mensual"/>
                    <field name="concepto_fijo_computable_mensual"/>
                    <separator string="Sueldo Anterior"/>
                    <field name="previous_wage"/>
                    <separator string="Renta de Quinta - Otro Trabajo"/>
                    <field name="r5_other_job"/>
                    <field name="r5_other_job_wage" invisible="not r5_other_job"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
