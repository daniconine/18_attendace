<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST -->
    <record id="view_zemployee_extension_list" model="ir.ui.view">
        <field name="name">zemployee.extension.list</field>
        <field name="model">zemployee.extension</field>
        <field name="arch" type="xml">
            <list string="Extensiones de Empleado">
                <field name="employee_id"/>
                <field name="company_id"/>
                
                <field name="pe_labor_regime_id"/>
                <field name="pe_pension_scheme"/>
                <field name="pe_health_scheme"/>
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_zemployee_extension_form" model="ir.ui.view">
        <field name="name">zemployee.extension.form</field>
        <field name="model">zemployee.extension</field>
        <field name="arch" type="xml">
            <form string="Extensión del Empleado">
                <sheet>

                    <!-- Encabezado -->
                    <group>
                        <group string="Datos del Trabajador">
                            <field name="employee_id"/>
                            <field name="company_id" readonly="1"/>
                        </group>

                        <group string="Fechas Laborales">
                            <field name="entry_date"/>
                            <field name="termination_date"/>
                        </group>
                    </group>
                   
                    <separator/>
                    <separator string="Datos Laborales de la Normativa Peruana"/>

                    <notebook>

                        <!-- Información laboral -->
                        <page string="Información Laboral">
                            <group>
                                <group string="Régimen Laboral">
                                    <field name="pe_labor_regime_id"/>
                                    <field name="study_school_type"/>
                                </group>

                                <group string="Condiciones del Trabajador">
                                    <field name="is_disabled_person"/>
                                    <field name="is_family_mother"/>
                                </group>
                            </group>
                        </page>

                        <!-- Seguridad social / pensión -->
                        <page string="Pensión y Salud">
                            <group>
                                <group string="Sistema de Pensiones">
                                    <field name="pe_pension_scheme"/>

                                    <field name="afp_id" invisible="pe_pension_scheme != 'spp'"
                                                        required="pe_pension_scheme == 'spp'"/>

                                    <field name="afp_commission_type" invisible="pe_pension_scheme != 'spp'"
                                                                    required="pe_pension_scheme == 'spp'"/>

                                    <field name="cuspp" invisible="pe_pension_scheme != 'spp'"
                                                        required="pe_pension_scheme == 'spp'"/>

                                    <field name="pensioner_type"/>
                                </group>

                                <group string="Salud y Riesgo">
                                    <field name="pe_health_scheme"/>
                                    <field name="sctr_table"/>
                                </group>
                            </group>
                        </page>

                        <!-- Descuento judicial -->
                        <page string="Descuento Judicial">
                            <group>
                                <group string="Configuración del Descuento">
                                    <field name="judicial_deduction_type"/>
                                    <field name="judicial_deduction_amount"/>
                                </group>
                            </group>
                        </page>

                        <!-- Familiares -->
                        <page string="Familiares">
                            <field name="family_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="relationship"/>
                                    <field name="birth_date"/>
                                </list>
                            </field>
                        </page>

                        <!-- Cuentas bancarias -->
                        <page string="Cuentas Bancarias">
                            <field name="cuentas_bancarias_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="bank_id"/>
                                    <field name="account_number"/>
                                    <field name="cci"/>
                                    <field name="currency_id"/>
                                </list>
                            </field>
                        </page>

                    </notebook>

                </sheet>

                <!-- CHATTER -->
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                    <field name="activity_ids"/>
                </chatter>

            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_zemployee_extension" model="ir.actions.act_window">
        <field name="name">Extension del Empleado Zemployee</field>
        <field name="res_model">zemployee.extension</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>