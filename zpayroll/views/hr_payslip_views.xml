<odoo>
    <record id="hr_payslip_view_form_inherit_params_layout" model="ir.ui.view">
        <field name="name">hr.payslip.view.form.inherit.params.layout</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll_community.hr_payslip_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet/group[@col='4']" position="replace">
                <group>
                    <group string="Datos de la nómina">
                        <label for="date_from" string="Period"/>
                        <div>
                            <field name="date_from" class="oe_inline" readonly="state != 'draft'"/>
                            -
                            <field name="date_to" class="oe_inline" readonly="state != 'draft'"/>
                        </div>

                        <field name="contract_id"
                            domain="[('employee_id','=',employee_id),('date_start','&lt;=',date_to),'|',('date_end','&gt;=',date_from),('date_end','=',False)]"
                            context="{'default_employee_id': employee_id}"
                            readonly="state != 'draft'"/>

                        <field name="number" readonly="state != 'draft'"/>
                        <field name="struct_id" readonly="state != 'draft'"/>
                        <field name="name" readonly="state != 'draft'"/>
                        <field name="credit_note" readonly="state != 'draft'"/>
                        <field name="payroll_type"/>
                        <field name="remuneracion_computable"/>
                        <field name="renta_5ta_retencion"/>
                    </group>

                    <group string="Parámetros de cálculo">
                        <field name="payroll_year" readonly="1"/>
                        <field name="payroll_month" readonly="1"/>
                        <field name="payroll_month_number" readonly="1"/>
                        <field name="payroll_period_code" readonly="1"/>
                        <field name="uit" readonly="1"/>
                        <field name="rmv" readonly="1"/>
                        <field name="onp_rate" readonly="1"/>
                        <field name="essalud_rate" readonly="1"/>
                        <field name="eps" readonly="1"/>
                        <field name="eps_essalud_rate" readonly="1"/>
                    </group>
                </group>
            </xpath>

        </field>
    </record>

      <record id="hr_payslip_tree_inherit_zpayroll_fields" model="ir.ui.view">
            <field name="name">hr.payslip.tree.inherit.zpayroll.fields</field>
            <field name="model">hr.payslip</field>
            <field name="inherit_id" ref="hr_payroll_community.hr_payslip_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="before">
                    <field name="payroll_month"/>
                    <field name="payroll_year"/>
                    <field name="payroll_type"/>
                    <field name="renta_5ta_retencion"/>
                </xpath>
            </field>
        </record>


    <!-- Agrupa por mes las nominas -->
    <record id="hr_payroll_community.hr_payslip_action" model="ir.actions.act_window">
        <field name="context">{'search_default_group_by_payroll_month': 1}</field>
    </record>

    <!-- Agrupa por mes las nominas en la vista search-->
    <record id="hr_payslip_search_inherit_payroll_month" model="ir.ui.view">
        <field name="name">hr.payslip.search.inherit.payroll.month</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll_community.hr_payslip_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search/group" position="inside">
                <filter string="Mes"
                        name="group_by_payroll_month"
                        context="{'group_by':'payroll_month'}"/>
            </xpath>
        </field>
    </record>

</odoo>