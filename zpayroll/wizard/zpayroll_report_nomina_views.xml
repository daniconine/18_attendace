<odoo>
    <data>

        <record id="view_zpayroll_report_wizard_form" model="ir.ui.view">
            <field name="name">zpayroll.report.wizard.form</field>
            <field name="model">zpayroll.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Reporte Mensual de Planilla">
                    <group>
                        <group>
                            <field name="payroll_month"/>
                            <field name="payroll_year"/>
                            <field name="company_id"/>
                        </group>

                        <group>
                            <field name="employee_selection" widget="radio"/>
                            <field
                                name="employee_ids"
                                widget="many2many_tags"
                                invisible="employee_selection != 'specific'"
                            />
                        </group>
                    </group>

                    <footer>
                        <button
                            name="action_print_xlsx"
                            string="Generar Excel"
                            type="object"
                            class="btn-primary"
                        />
                        <button
                            string="Cancelar"
                            special="cancel"
                            class="btn-secondary"
                        />
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_zpayroll_report_wizard" model="ir.actions.act_window">
            <field name="name">Reporte Mensual de Planilla</field>
            <field name="res_model">zpayroll.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <record id="action_report_payroll_monthly_xlsx" model="ir.actions.report">
            <field name="name">Reporte Mensual de Planilla</field>
            <field name="model">zpayroll.report.wizard</field>
            <field name="report_type">xlsx</field>
            <field name="report_name">zpayroll.report_payroll_monthly_xlsx</field>
            <field name="report_file">reporte_planilla_mensual_xlsx</field>
        </record>

    </data>
</odoo>
