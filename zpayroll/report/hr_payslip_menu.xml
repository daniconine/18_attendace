<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Acción para abrir boletas de pago -->
    <record id="action_hr_payslip_boleta_pago" model="ir.actions.act_window">
        <field name="name">Boletas de Pago</field>
        <field name="res_model">hr.payslip</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Selecciona una boleta de pago para imprimir el PDF.
            </p>
        </field>
    </record>

    <!-- Menú Reports dentro de Payroll -->
    <menuitem id="menu_hr_payroll_community_reports"
              name="Reports"
              parent="hr_payroll_community.menu_hr_payroll_community_root"
              sequence="90"
              groups="hr_payroll_community.group_hr_payroll_community_manager"/>

    <!-- Submenú Boletas de Pago -->
    <menuitem id="menu_hr_payslip_boleta_pago"
              name="Boletas de Pago"
              parent="menu_hr_payroll_community_reports"
              action="action_hr_payslip_boleta_pago"
              sequence="10"
              groups="hr_payroll_community.group_hr_payroll_community_manager"/>
    
    <!-- Submenú Reporte Mensual de Planilla -->
    <menuitem id="menu_zpayroll_report_planilla_mensual"
            name="Reporte Mensual de Planilla"
            parent="menu_hr_payroll_community_reports"
            action="action_zpayroll_report_wizard"
            sequence="20"
            groups="hr_payroll_community.group_hr_payroll_community_manager"/>

    <!-- Submenu reporte de reglas salairales-->
    <menuitem id="menu_zpayroll_report_rule_salary"
            name="Reporte de Regla Salarial"
            parent="menu_hr_payroll_community_reports"
            action="action_zpayroll_report_rule_salary_wizard"
            sequence="30"
            groups="hr_payroll_community.group_hr_payroll_community_manager"
            />


    <!-- Submenu para agrear en configuracion de nominas-->
    <menuitem id="menu_zpayroll_parameters"
          name="Parámetros de Nómina"
          action="action_zpayroll_parameters"
          parent="hr_payroll_community.menu_hr_payroll_community_configuration"
          sequence="13"/>

</odoo>