<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_report_boleta_pago" model="ir.actions.report">
        <field name="name">Boleta de Pago</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zpayroll.report_boleta_pago_document</field>
        <field name="report_file">zpayroll.report_boleta_pago_document</field>
        <field name="paperformat_id" ref="zpayroll.paperformat_boleta_pago_a4"/>
        <field name="binding_model_id" ref="hr_payroll_community.model_hr_payslip"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">list,form</field>
        <field name="print_report_name">('Boleta de Pago - %s' % (object.payslip_nickname or object.name or '')).replace('/', '-')</field>
    </record>

    <record id="action_server_send_boleta_pago_email" model="ir.actions.server">
        <field name="name">Enviar Boleta por Correo</field>
        <field name="model_id" ref="hr_payroll_community.model_hr_payslip"/>
        <field name="binding_model_id" ref="hr_payroll_community.model_hr_payslip"/>
        <field name="binding_type">report</field>
        <field name="state">code</field>
        <field name="groups_id" eval="[(4, ref('hr_payroll_community.group_hr_payroll_community_manager'))]"/>
        <field name="code"><![CDATA[
action = records.action_send_boleta_pago_email_employee()
        ]]></field>
    </record>

    <template id="report_boleta_pago_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">

                <t t-set="data" t-value="report_data_by_id.get(o.id)"/>
                <t t-set="emp_data" t-value="data['employee']"/>
                <t t-set="period_data" t-value="data['period']"/>

                <t t-call="web.external_layout">
                    <t t-set="company" t-value="o.company_id"/>
                    <t t-set="currency" t-value="company.currency_id"/>

                    <div class="page boleta-page">

                        <style>
                            .boleta-page {
                                font-family: Arial, Helvetica, sans-serif;
                                font-size: 11px;
                                color: #000000;
                                padding-top: 60mm;
                            }

                            .boleta-title {
                                text-align: center;
                                font-size: 23px;
                                font-weight: bold;
                                font-style: italic;
                                margin: 0 0 20px 0;
                                letter-spacing: 1px;
                            }

                            table {
                                page-break-inside: avoid;
                            }

                            .info-table,
                            .main-table,
                            .footer-table {
                                width: 100%;
                                border-collapse: collapse;
                            }

                            .info-table th,
                            .info-table td,
                            .main-table th,
                            .main-table td,
                            .footer-table th,
                            .footer-table td {
                                border: 1px solid #000000;
                                padding: 3px 4px;
                                vertical-align: middle;
                            }

                            .info-table th,
                            .main-table th,
                            .footer-table th {
                                font-weight: bold;
                                text-align: center;
                            }

                            .text-center {
                                text-align: center;
                            }

                            .text-right {
                                text-align: right;
                            }

                            .text-left {
                                text-align: left;
                            }

                            .section-title {
                                font-size: 13px;
                                font-weight: bold;
                                text-align: center;
                                padding: 5px;
                            }

                            .concept-row {
                                height: 300px;
                            }

                            .concept-cell {
                                vertical-align: top !important;
                                padding-top: 8px !important;
                            }

                            .concept-line {
                                min-height: 18px;
                                line-height: 18px;
                            }

                            .muted {
                                color: #eeeeee;
                            }

                            .total-row th,
                            .total-row td {
                                font-weight: bold;
                            }

                            .neto-box {
                                font-size: 12px;
                                font-weight: bold;
                            }

                            .month-box {
                                margin-top: 18px;
                                font-size: 11px;
                                font-weight: bold;
                            }

                            .month-value {
                                margin-left: 25px;
                                font-size: 10px;
                            }

                            .signature-table {
                                width: 100%;
                                margin-top: 45px;
                                border-collapse: collapse;
                            }

                            .signature-table td {
                                width: 50%;
                                text-align: center;
                                border: none;
                                padding: 0 16px;
                            }

                            .signature-space {
                                height: 42px;
                            }

                            .signature-line {
                                border-top: 2px solid #000000;
                                width: 100%;
                                margin-bottom: 18px;
                            }

                            .signature-label {
                                font-size: 12px;
                                font-weight: bold;
                            }
                        </style>

                        

                        <div class="boleta-title">BOLETA&#160;&#160;DE&#160;&#160;PRUEBA</div>

                        <!-- DATOS DEL TRABAJADOR -->
                        <table class="info-table">
                             <tr>
                                <th style="width: 10%;">CODIGO CONTRATO</th>
                                <th style="width: 37%;">APELLIDOS Y NOMBRES</th>
                                <th style="width: 7%;">SEXO</th>
                                <th style="width: 16%;">F. NACIMIENTO</th>
                                <th style="width: 17%;">F. INGRESO</th>
                                <th style="width: 13%;">F. CESE</th>
                            </tr>

                            <tr class="text-center">
                                <td><span t-esc="emp_data['contract_code']"/></td>
                                <td><span t-esc="emp_data['name']"/></td>
                                <td><span t-esc="emp_data['gender']"/></td>
                                <td><span t-esc="emp_data['birthday']"/></td>
                                <td><span t-esc="emp_data['entry_date']"/></td>
                                <td><span t-esc="emp_data['termination_date']"/></td>
                            </tr>

                            <tr>
                                <th>CARGO</th>
                                <th>SUELDO BÁSICO</th>
                                <th colspan="2">TIPO DE CONTRATO</th>
                                <th>SITUACION<br/>ESPECIAL</th>
                                <th>C.COSTOS</th>
                            </tr>
                            <tr class="text-center">
                                <td><span t-esc="emp_data['job']"/></td>
                                <td><span t-esc="emp_data['wage']"
                                        t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                <td colspan="2"><span t-esc="emp_data['contract_type']"/></td>
                                <td><span t-esc="emp_data['special_situation']"/></td>
                                <td></td>
                            </tr>

                            <tr>
                                <th>Nº AUTOGENERADO ESSALUD</th>
                                <th>CUSPP</th>
                                <th colspan="2">NOMBRE AFP</th>
                                <th>DOC. IDENTIDAD</th>
                                <th>NACIONALIDAD</th>
                            </tr>
                            <tr class="text-center">
                                <td><span t-esc="emp_data['essalud_autogenerated']"/></td>
                                <td><span t-esc="emp_data['cuspp']"/></td>
                                <td colspan="2"><span t-esc="emp_data['afp']"/></td>
                                <td><span t-esc="emp_data['identification_id']"/></td>
                                <td><span t-esc="emp_data['nationality']"/></td>
                            </tr>

                            <tr>
                                <th>PERIODO DE PAGO</th>
                                <th>DIRECCION</th>
                                <th colspan="2">Licencia / Vacaciones</th>
                                <th>Fecha Inicio</th>
                                <th>Fecha Final</th>
                            </tr>

                            <tr class="text-center">
                                <td style="height: 42px; vertical-align: middle;">
                                    <span t-esc="period_data['period_name']"/>
                                </td>

                                <td class="text-center" style="vertical-align: middle;">
                                    <span t-esc="emp_data['address']"/>
                                    <br/>
                                    <span t-esc="emp_data.get('address2') or ''"/>
                                </td>

                                <td colspan="4"
                                    style="padding: 0;
                                        vertical-align: middle;
                                        border-left: 1px solid #000 !important;
                                        border-right: 1px solid #000 !important;
                                        border-bottom: 1px solid #000 !important;">

                                    <table style="width: 100%;
                                                border-collapse: collapse;
                                                margin: 0;
                                                border: none !important;">
                                        <tbody style="border: none !important;">
                                            <tr t-foreach="emp_data['leave_rows']" t-as="leave" style="border: none !important;">

                                                <td colspan="2"
                                                    style="width: 50%;
                                                        padding: 4px 6px;
                                                        border: none !important;
                                                        text-align: center;">
                                                    <span t-esc="leave.get('leave_type')"/>
                                                </td>

                                                <td style="width: 25%;
                                                        padding: 4px 6px;
                                                        border: none !important;
                                                        text-align: center;">
                                                    <span t-esc="leave.get('leave_start_date')"/>
                                                </td>

                                                <td style="width: 25%;
                                                        padding: 4px 6px;
                                                        border: none !important;
                                                        text-align: center;">
                                                    <span t-esc="leave.get('leave_end_date')"/>
                                                </td>

                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>

                        </table>
                        <br/>

                       
                        <!-- GANANCIAS Y DESCUENTOS -->
                        <table class="main-table">
                            <tr>
                                <th colspan="3" class="section-title">GANANCIAS</th>
                                <th colspan="2" class="section-title">DESCUENTOS</th>
                            </tr>
                            <tr>
                                <th style="width: 22%;">DESCRIPCION</th>
                                <th style="width: 9%;">DÍAS/Horas</th>
                                <th style="width: 23%;">IMPORTE</th>
                                <th style="width: 28%;">DESCRIPCION</th>
                                <th style="width: 18%;">IMPORTE</th>
                            </tr>
                            <!-- DESCRIPCIÓN GANANCIAS -->
                            <tr class="concept-row">
                                <td class="concept-cell">
                                    <t t-foreach="data['earnings']" t-as="concept">
                                        <div class="concept-line"><span t-esc="concept['name']"/></div>
                                    </t>
                                </td>
                                <!-- DÍAS / HORAS -->
                                <td class="concept-cell text-center">
                                    <t t-foreach="data['earnings']" t-as="concept">
                                        <div class="concept-line"><span t-esc="concept['qty_label']"/></div>
                                    </t>
                                </td>
                                <!-- IMPORTE GANANCIAS -->
                                <td class="concept-cell text-right">
                                    <t t-foreach="data['earnings']" t-as="concept">
                                        <div class="concept-line"><span t-esc="concept['amount']"
                                                t-options="{'widget': 'monetary', 'display_currency': currency}"/></div>
                                    </t>
                                </td>
                                <!-- LINEAS DE DESCUENTOS PARA PRUEBA -->
                                <!-- DESCRIPCIÓN DESCUENTOS -->
                                <td class="concept-cell">
                                    <t t-foreach="data['deductions']" t-as="concept">
                                        <div class="concept-line"><span t-esc="concept['name']"/></div>
                                    </t>
                                </td>
                                <!-- IMPORTE DESCUENTOS -->
                                <td class="concept-cell text-right">
                                    <t t-foreach="data['deductions']" t-as="concept">
                                        <div class="concept-line"><span t-esc="concept['amount']"
                                                t-options="{'widget': 'monetary', 'display_currency': currency}"/></div>
                                    </t>
                                </td>
                            </tr>

                            <tr class="total-row">
                                <th colspan="2" class="text-left">TOTAL GANANCIAS</th>
                                <td class="text-right"><span t-esc="data['totals']['total_earnings']"
                                        t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>

                                <th class="text-left">TOTAL DESCUENTOS</th>
                                <td class="text-right"><span t-esc="data['totals']['total_deductions']"
                                        t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                            </tr>
                        </table>

                        <!-- APORTACIONES / NETO -->
                        <table class="footer-table">
                            <tr>
                                <th colspan="4" style="width: 54%;">APORTACIONES PATRONALES</th>
                                <th class="neto-box" style="width: 28%;">NETO A PAGAR</th>

                                <td class="text-right neto-box" style="width: 18%;">
                                    <span t-esc="data['totals']['net_amount']"
                                        t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                            </tr>

                            <tr>
                                <th>S.C.T.R.</th>
                                <th>ESSALUD</th>
                                <th>SENATI</th>
                                <th>E.P.S.</th>
                                <td colspan="2" rowspan="2"></td>
                            </tr>

                            <tr class="text-right">
                                <td><span t-esc="data['employer_contributions']['sctr']"
                                        t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                <td><span t-esc="data['employer_contributions']['essalud']"
                                        t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                <td><span t-esc="data['employer_contributions']['senati']"
                                        t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                <td><span t-esc="data['employer_contributions']['eps']"
                                        t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                            </tr>
                        </table>

                        <!-- MES -->
                        <div class="month-box">
                            MES :
                            <span class="month-value">
                                <span t-esc="period_data['period_name']"/>
                            </span>
                        </div>

                        <!-- FIRMAS -->
                        <table class="signature-table">
                            <tr>
                                <td>
                                    <div class="signature-space"></div>
                                    <div class="signature-line"></div>
                                    <div class="signature-label">FIRMA DEL EMPLEADO</div>
                                </td>
                                <td>
                                    <div class="signature-space"></div>
                                    <div class="signature-line"></div>
                                    <div class="signature-label">FIRMA Y SELLO DEL EMPLEADOR</div>
                                </td>
                            </tr>
                        </table>

                    </div>

                </t>
            </t>
        </t>
    </template>

</odoo>