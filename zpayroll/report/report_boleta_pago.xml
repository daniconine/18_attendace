<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_report_boleta_pago" model="ir.actions.report">
        <field name="name">Boleta de Pago</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zpayroll.report_boleta_pago_document</field>
        <field name="report_file">zpayroll.report_boleta_pago_document</field>
        <field name="paperformat_id" ref="zpayroll.paperformat_boleta_pago_a4"/>
        <field name="binding_model_id" ref="hr_payroll_community.model_hr_payslip"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">list,form</field>
        <field name="print_report_name">'Boleta de Pago - %s' % (object.name or '')</field>
    </record>

    <record id="action_server_send_boleta_pago_email" model="ir.actions.server">
        <field name="name">Enviar Boleta por Correo</field>
        <field name="model_id" ref="hr_payroll_community.model_hr_payslip"/>
        <field name="binding_model_id" ref="hr_payroll_community.model_hr_payslip"/>
        <field name="binding_type">report</field>
        <field name="state">code</field>
        <field name="groups_id" eval="[(4, ref('hr_payroll_community.group_hr_payroll_community_manager'))]"/>
        <field name="code"><![CDATA[
action = records.action_send_boleta_pago_email_static()
        ]]></field>
    </record>

    <template id="report_boleta_pago_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="emp" t-value="o.employee_id"/>
                    <t t-set="contract" t-value="o.contract_id"/>
                    <t t-set="company" t-value="o.company_id"/>
                    <t t-set="currency" t-value="company.currency_id"/>

                    <t t-set="emp_ext"
                        t-value="o.env['zemployee.extension'].sudo().search([('employee_id', '=', emp.id)], limit=1)"/>
                    <t t-set="payroll_month_name"
                        t-value="dict(o._fields['payroll_month'].selection).get(o.payroll_month, '')"/>


                    <div class="page" style="font-size: 11px;">

                        <style>
                            .boleta-page {
                                font-family: Arial, Helvetica, sans-serif;
                                font-size: 11px;
                                color: #000000;
                            }

                            .boleta-header {
                                width: 100%;
                                border-collapse: collapse;
                                margin-bottom: 10px;
                            }

                            .boleta-header td {
                                border: none;
                                padding: 0;
                                vertical-align: top;
                            }

                            .company-name {
                                font-size: 17px;
                                font-weight: bold;
                                font-style: italic;
                                margin-bottom: 4px;
                            }

                            .company-ruc {
                                font-size: 16px;
                                font-weight: bold;
                                font-style: italic;
                            }

                            .logo-box {
                                text-align: right;
                                font-size: 28px;
                                font-weight: bold;
                                color: #1599d3;
                                letter-spacing: 2px;
                            }

                            .logo-subtitle {
                                font-size: 11px;
                                color: #1599d3;
                                letter-spacing: 7px;
                                font-weight: normal;
                            }

                            .boleta-title {
                                text-align: center;
                                font-size: 23px;
                                font-weight: bold;
                                font-style: italic;
                                margin: 18px 0 28px 0;
                                letter-spacing: 1px;
                            }

                            table {
                                page-break-inside: avoid;
                            }

                            .info-table,
                            .main-table,
                            .footer-table {
                                width: 100%;
                                border-collapse: collapse;
                            }

                            .info-table th,
                            .info-table td,
                            .main-table th,
                            .main-table td,
                            .footer-table th,
                            .footer-table td {
                                border: 1px solid #000000;
                                padding: 3px 4px;
                                vertical-align: middle;
                            }

                            .info-table th,
                            .main-table th,
                            .footer-table th {
                                font-weight: bold;
                                text-align: center;
                            }

                            .text-center {
                                text-align: center;
                            }

                            .text-right {
                                text-align: right;
                            }

                            .text-left {
                                text-align: left;
                            }

                            .section-title {
                                font-size: 13px;
                                font-weight: bold;
                                text-align: center;
                                padding: 5px;
                            }

                            .concept-row {
                                height: 300px;
                            }

                            .concept-cell {
                                vertical-align: top !important;
                                padding-top: 8px !important;
                            }

                            .concept-line {
                                min-height: 18px;
                                line-height: 18px;
                            }

                            .muted {
                                color: #eeeeee;
                            }

                            .total-row th,
                            .total-row td {
                                font-weight: bold;
                            }

                            .neto-box {
                                font-size: 12px;
                                font-weight: bold;
                            }

                            .month-box {
                                margin-top: 18px;
                                font-size: 11px;
                                font-weight: bold;
                            }

                            .month-value {
                                margin-left: 25px;
                                font-size: 10px;
                            }

                            .signature-table {
                                width: 100%;
                                margin-top: 45px;
                                border-collapse: collapse;
                            }

                            .signature-table td {
                                width: 50%;
                                text-align: center;
                                border: none;
                                padding: 0 16px;
                            }

                            .signature-space {
                                height: 42px;
                            }

                            .signature-line {
                                border-top: 2px solid #000000;
                                width: 100%;
                                margin-bottom: 18px;
                            }

                            .signature-label {
                                font-size: 12px;
                                font-weight: bold;
                            }
                        </style>

                        <!-- CABECERA -->
                        <table class="boleta-header">
                            <tr>
                                <td style="width: 65%;">
                                    <div class="company-name">Escuela de Postgrado Gerens S.A.</div>
                                    <div class="company-ruc">RUC&#160;&#160;:&#160;&#160;&#160;20552324316</div>
                                </td>
                                <td style="width: 35%;">
                                    <div class="logo-box">
                                        GERENS
                                        <div class="logo-subtitle">ESCUELA DE</div>
                                        <div class="logo-subtitle">POSTGRADO</div>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <div class="boleta-title">BOLETA&#160;&#160;DE&#160;&#160;PRUEBA</div>

                        <!-- DATOS DEL TRABAJADOR -->
                        <table class="info-table">
                            <tr>
                                <th style="width: 10%;">CODIGO CONTRATO</th>
                                <th style="width: 37%;">APELLIDOS Y NOMBRES</th>
                                <th style="width: 7%;">SEXO</th>
                                <th style="width: 16%;">F. NACIMIENTO</th>
                                <th style="width: 17%;">F. INGRESO</th>
                                <th style="width: 13%;">F. CESE</th>
                            </tr>
                            <tr class="text-center">
                                <td><span t-esc="contract.code"/></td>
                                <td><span t-esc="emp.name or ''"/></td>
                                <td><span t-esc="emp.gender or ''"/></td>
                                <td><span t-field="emp.birthday"/></td>
                                <td><span t-field="emp_ext.entry_date"/></td>
                                <td><span t-field="emp_ext.termination_date"/></td>
                            </tr>

                            <tr>
                                <th>CARGO</th>
                                <th>SUELDO BÁSICO</th>
                                <th colspan="2">TIPO DE CONTRATO</th>
                                <th>SITUACION<br/>ESPECIAL</th>
                                <th>C.COSTOS</th>
                            </tr>
                            <tr class="text-center">
                                <td><span t-esc="emp.job_id.name or ''"/></td>
                                <td><span t-field="contract.wage"
                                    t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                <td colspan="2"><span t-esc="contract.contract_type_id.name or ''"/></td>
                                <td>Ninguna</td>
                                <td></td>
                            </tr>

                            <tr>
                                <th>Nº AUTOGENERADO ESSALUD</th>
                                <th>CUSPP</th>
                                <th colspan="2">NOMBRE AFP</th>
                                <th>DOC. IDENTIDAD</th>
                                <th>NACIONALIDAD</th>
                            </tr>
                            <tr class="text-center">
                                <td>9111231CRHCD008</td>
                                <td><span t-esc="emp_ext.cuspp or ''"/></td>
                                <td colspan="2"><span t-esc="emp_ext.afp_id.name or ''"/></td>
                                <td><span t-esc="emp.identification_id or ''"/></td>
                                <td><span t-esc="emp.country_id or ''"/></td>
                            </tr>

                            <tr>
                                <th>PERIODO DE PAGO</th>
                                <th>DIRECCION</th>
                                <th colspan="2">Licencia / Vacaciones</th>
                                <th>Fecha Inicio</th>
                                <th>Fecha Final</th>
                            </tr>

                            <tr class="text-center">
                                <td style="height: 42px;">
                                    <span t-esc="'%s - %s' % (payroll_month_name or '', o.payroll_year or '')"/>
                                </td>

                                <td class="text-center">
                                    <span t-esc="emp.private_street or ''"/>
                                </td>

                                <td colspan="2">
                                    &#160;
                                </td>

                                <td>
                                    &#160;
                                </td>

                                <td>
                                    &#160;
                                </td>
                            </tr>
                        </table>

                        <br/>

                        <t t-set="line_basic" t-value="o.line_ids.filtered(lambda l: l.code == 'BASIC')[:1]"/>
                        <t t-set="line_asig" t-value="o.line_ids.filtered(lambda l: l.code == 'ASIG_FAMILIAR')[:1]"/>



                        <!-- GANANCIAS Y DESCUENTOS -->
                        <table class="main-table">
                            <tr>
                                <th colspan="3" class="section-title">GANANCIAS</th>
                                <th colspan="2" class="section-title">DESCUENTOS</th>
                            </tr>
                            <tr>
                                <th style="width: 22%;">DESCRIPCION</th>
                                <th style="width: 9%;">DÍAS/Horas</th>
                                <th style="width: 23%;">IMPORTE</th>
                                <th style="width: 28%;">DESCRIPCION</th>
                                <th style="width: 18%;">IMPORTE</th>
                            </tr>

                            <tr class="concept-row">
                                <td class="concept-cell">
                                    <div class="concept-line">Sueldo Básico</div>
                                    <div class="concept-line"><t t-if="line_asig and abs(line_asig.total) > 0">
                                                            Asignación Familiar</t><t t-else="">&#160;</t></div>
                                    <div class="concept-line muted">Horas Extras</div>
                                    <div class="concept-line muted">Clases</div>
                                    <div class="concept-line muted">Comisión Ventas</div>
                                    <div class="concept-line muted">Bonificación</div>
                                    <br/>
                                    <div class="concept-line muted">Vacaciones</div>
                                    <div class="concept-line muted">Vacaciones Truncas</div>
                                    <div class="concept-line muted">Gratificación Trunca</div>
                                    <div class="concept-line muted">Compensación Vacacional</div>
                                    <div class="concept-line muted">Gratificación Fiestas Patrias</div>
                                    <div class="concept-line muted">Bonif. Extraod. Ley 30334</div>
                                    <div class="concept-line muted">CTS</div>
                                </td>

                                <td class="concept-cell text-center">
                                    <div class="concept-line">11/81</div>
                                </td>

                                <td class="concept-cell text-right">
                                    <div class="concept-line">
                                        <t t-if="line_basic and abs(line_basic.total) > 0">
                                            <span t-esc="line_basic.total"
                                                t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </t><t t-else="">&#160;</t></div>
                                    <div class="concept-line">
                                        <t t-if="line_asig and abs(line_asig.total) > 0">
                                            <span t-esc="line_asig.total"
                                                t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </t>
                                        <t t-else="">
                                            &#160;
                                        </t>
                                    </div>
                                    <div class="concept-line muted">&#160;</div>
                                    <div class="concept-line muted">&#160;</div>
                                    <div class="concept-line muted">&#160;</div>
                                    <div class="concept-line muted">&#160;</div>
                                    <br/>
                                    <div class="concept-line muted">&#160;</div>
                                    <div class="concept-line muted">&#160;</div>
                                    <div class="concept-line muted">&#160;</div>
                                    <div class="concept-line muted">&#160;</div>
                                    <div class="concept-line muted">&#160;</div>
                                    <div class="concept-line muted">0</div>
                                </td>



<!-- LINEAS DE DESCUENTOS PARA PRUEBA -->
<t t-set="line_afp_fondo" t-value="o.line_ids.filtered(lambda l: l.code == 'AFP-FONDO')[:1]"/>
<t t-set="line_afp_seguro" t-value="o.line_ids.filtered(lambda l: l.code == 'AFP-SEGURO')[:1]"/>
<t t-set="line_afp_comision" t-value="o.line_ids.filtered(lambda l: l.code == 'AFP-COMISION')[:1]"/>
<t t-set="line_renta5" t-value="o.line_ids.filtered(lambda l: l.code == 'R5_RET')[:1]"/>

                                <td class="concept-cell">
                                    <div class="concept-line muted">SNP</div>
                                    <div class="concept-line">Fondo de Pensiones AFP</div>
                                    <div class="concept-line">Seguro Inv. AFP</div>
                                    <div class="concept-line">Comis. Porc. AFP</div>
                                    <div class="concept-line muted">Adelanto</div>
                                    <div class="concept-line muted">E.P.S.</div>
                                    <div class="concept-line muted">Prestamos al Personal</div>
                                    <div class="concept-line muted">Tardanzas</div>
                                    <div class="concept-line muted">Renta 5ta Categoría</div>
                                    <div class="concept-line muted">Gratificación</div>
                                    <div class="concept-line muted">Préstamo CERTIKREDIT</div>
                                    <div class="concept-line muted">Pago Utilidades 2014</div>
                                    <div class="concept-line muted">Otros Descuentos</div>
                                </td>

                                <td class="concept-cell text-right">

                                    <!-- Fondo de Pensiones AFP -->
                                    <div class="concept-line">
                                        <t t-if="line_afp_fondo and abs(line_afp_fondo.total) > 0">
                                            <span t-esc="abs(line_afp_fondo.total)"
                                                t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </t>
                                        <t t-else="">&#160;</t>
                                    </div>

                                    <!-- Seguro Inv. AFP -->
                                    <div class="concept-line">
                                        <t t-if="line_afp_seguro and abs(line_afp_seguro.total) > 0">
                                            <span t-esc="abs(line_afp_seguro.total)"
                                                t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </t>
                                        <t t-else="">&#160;</t>
                                    </div>

                                    <!-- Comisión AFP -->
                                    <div class="concept-line">
                                        <t t-if="line_afp_comision and abs(line_afp_comision.total) > 0">
                                            <span t-esc="abs(line_afp_comision.total)"
                                                t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </t>
                                        <t t-else="">&#160;</t>
                                    </div>

                                    <!-- Adelanto -->
                                    <div class="concept-line muted">&#160;</div>

                                    <!-- E.P.S. -->
                                    <div class="concept-line muted">&#160;</div>

                                    <!-- Prestamos al Personal -->
                                    <div class="concept-line muted">&#160;</div>

                                    <!-- Tardanzas -->
                                    <div class="concept-line muted">&#160;</div>

                                    <!-- Renta 5ta Categoría -->
                                    <div class="concept-line">
                                        <t t-if="line_renta5 and abs(line_renta5.total) > 0">
                                            <span t-esc="abs(line_renta5.total)"
                                                t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </t>
                                        <t t-else="">&#160;</t>
                                    </div>


                                </td>
                            </tr>

                            <tr class="total-row">
                                <th colspan="2" class="text-left">TOTAL GANANCIAS</th>
                                <td class="text-right">660</td>
                                <th class="text-left">TOTAL DESCUENTOS</th>
                                <td class="text-right">77.48</td>
                            </tr>
                        </table>

                        <!-- APORTACIONES / NETO -->
                        <table class="footer-table">
                            <tr>
                                <th colspan="4" style="width: 54%;">APORTACIONES PATRONALES</th>
                                <th class="neto-box" style="width: 28%;">NETO A PAGAR</th>
                                <td class="text-right neto-box" style="width: 18%;">
                                    S/.&#160;&#160;&#160;582.52
                                </td>
                            </tr>
                            <tr>
                                <th>S.C.T.R.</th>
                                <th>ESSALUD</th>
                                <th>SENATI</th>
                                <th>E.P.S.</th>
                                <td colspan="2" rowspan="2"></td>
                            </tr>
                            <tr class="text-right">
                                <td></td>
                                <td>83.70</td>
                                <td>0.00</td>
                                <td></td>
                            </tr>
                        </table>

                        <!-- MES -->
                        <div class="month-box">
                            MES :
                            <span class="month-value">Junio -2026</span>
                        </div>

                        <!-- FIRMAS -->
                        <table class="signature-table">
                            <tr>
                                <td>
                                    <div class="signature-space"></div>
                                    <div class="signature-line"></div>
                                    <div class="signature-label">FIRMA DEL EMPLEADO</div>
                                </td>
                                <td>
                                    <div class="signature-space"></div>
                                    <div class="signature-line"></div>
                                    <div class="signature-label">FIRMA Y SELLO DEL EMPLEADOR</div>
                                </td>
                            </tr>
                        </table>

                    </div>

                </t>
            </t>
        </t>
    </template>

</odoo>