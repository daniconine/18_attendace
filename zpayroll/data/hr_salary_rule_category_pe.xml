<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="pe_cat_basic" model="hr.salary.rule.category">
            <field name="name">Remuneración Básica</field>
            <field name="code">PE_BASIC</field>
        </record>

        <record id="pe_cat_alw" model="hr.salary.rule.category">
            <field name="name">Asignaciones</field>
            <field name="code">PE_ALW</field>
        </record>

       
        <record id="pe_cat_rem_variable" model="hr.salary.rule.category">
            <field name="name">Remuneración Variable</field>
            <field name="code">PE_REM_COMP</field>
        </record>

        <record id="pe_cat_gross" model="hr.salary.rule.category">
            <field name="name">Total Ingresos</field>
            <field name="code">PE_GROSS</field>
        </record>


        <!-- ========================================================= -->
        <!-- CATEGORÍAS TÉCNICAS DE INGRESOS EXTRAORDINARIOS -->
        <!-- ========================================================= -->
        <record id="pe_cat_extra_r5" model="hr.salary.rule.category">
            <field name="name">Ingresos Extraordinarios Afectos R5</field>
            <field name="code">PE_EXTRA_R5</field>
            <field name="parent_id" ref="zpayroll.pe_cat_gross"/>
        </record>
        <record id="pe_cat_extra_no_r5" model="hr.salary.rule.category">
            <field name="name">Ingresos Extraordinarios No Afectos R5</field>
            <field name="code">PE_EXTRA_NO_R5</field>
            <field name="parent_id" ref="zpayroll.pe_cat_gross"/>
        </record>



        <record id="pe_cat_ded" model="hr.salary.rule.category">
            <field name="name">Descuentos</field>
            <field name="code">PE_DED</field>
        </record>

        <record id="pe_cat_net" model="hr.salary.rule.category">
            <field name="name">Neto a Pagar</field>
            <field name="code">PE_NET</field>
        </record>

        <record id="pe_cat_comp" model="hr.salary.rule.category">
            <field name="name">Aportes del Empleador</field>
            <field name="code">PE_COMP</field>
        </record>

        <record id="pe_cat_prov" model="hr.salary.rule.category">
            <field name="name">Provisiones</field>
            <field name="code">PE_PROV</field>
        </record>

        <record id="pe_cat_cts" model="hr.salary.rule.category">
            <field name="name">CTS</field>
            <field name="code">PE_CTS</field>
        </record>

        <record id="pe_cat_info" model="hr.salary.rule.category">
            <field name="name">Informativo / Reportes</field>
            <field name="code">PE_INFO</field>
        </record>

    </data>
</odoo>