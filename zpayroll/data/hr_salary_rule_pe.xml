            <field name="amount_select">code</field>
            
            <field name="amount_python_compute"><![CDATA[
try:
    real_payslip = payslip.env['hr.payslip'].browse(payslip.id)
    month = payslip.payroll_month_number or 0

    if not month:
        result = 0.0

    else:
        # 1. Retenciones anteriores de renta 5ta
        retenciones_anteriores = real_payslip.get_previous_amount('R5_RET',search_by='rule',use_absolute=True)

        # ============================================================
        # DICIEMBRE: AJUSTE FINAL CON RENTA REAL ANUAL
        # ============================================================
        if month == 12:

            # 2. Renta real anterior del año por categorías
            renta_basica_anterior = real_payslip.get_previous_amount('PE_BASIC',search_by='category',use_absolute=False)
            renta_variable_anterior = real_payslip.get_previous_amount('PE_REM_COMP',search_by='category',use_absolute=False)
            asignaciones_anteriores = real_payslip.get_previous_amount('PE_ALW',search_by='category',use_absolute=False)
            # 3. Renta real de la boleta actual de diciembre
            renta_basica_actual = categories.PE_BASIC if categories.PE_BASIC else 0.0
            renta_variable_actual = categories.PE_REM_COMP if categories.PE_REM_COMP else 0.0
            asignaciones_actuales = categories.PE_ALW if categories.PE_ALW else 0.0
            # 4. Renta proyectada del otro trabajo
            #    Solo se suma si el contrato tiene r5_other_job activado.
            renta_otro_trabajo = 0.0

            if contract.r5_other_job:
                other_wage = contract.r5_other_job_wage or 0.0

                if other_wage > 0:
                    tiene_asignacion = employee.has_family_allowance()

                    asignacion_familiar = 0.0
                    if tiene_asignacion:
                        asignacion_familiar = payslip.rmv * 0.10

                    factor_anual = 14 + (2 * ((payslip.essalud_rate or 0.0) / 100))
                    renta_otro_trabajo = ( other_wage + asignacion_familiar) * factor_anual

            # 5. Renta bruta anual real de quinta
            renta_real_anual = (renta_basica_anterior+ renta_variable_anterior+ asignaciones_anteriores
                + renta_basica_actual+ renta_variable_actual+ asignaciones_actuales+ renta_otro_trabajo)
            # 6. Impuesto anual real
            impuesto_real_anual = real_payslip.calculate_r5_annual_tax(renta_real_anual)
            # 7. Retención de diciembre = ajuste final
            retencion = impuesto_real_anual - retenciones_anteriores

            if retencion < 0:
                retencion = 0.0

        # ============================================================
        # ENERO A NOVIEMBRE: RETENCIÓN MENSUAL PROYECTADA
        # ============================================================
        else:

            # 2. Sueldo de otro trabajo
            other_wage = 0.0

            if contract.r5_other_job:
                other_wage = contract.r5_other_job_wage or 0.0

            # 3. Renta fija anual proyectada
            renta_fija_proyectada = real_payslip.calculate_r5_projected(contract.wage, other_wage)
            # 4. Variables anteriores del año
            variables_anteriores = real_payslip.get_previous_amount('PE_REM_COMP',search_by='category',use_absolute=False)
            # 5. Variables actuales de la boleta
            variables_actuales = categories.PE_REM_COMP if categories.PE_REM_COMP else 0.0
            # 6. Renta bruta anual proyectada
            renta_proyectada_anual = (renta_fija_proyectada+ variables_anteriores+ variables_actuales)
            # 7. Impuesto anual proyectado
            impuesto_proyectado_anual = real_payslip.calculate_r5_annual_tax(renta_proyectada_anual)
            # 8. Saldo pendiente de impuesto
            saldo_impuesto = impuesto_proyectado_anual - retenciones_anteriores

            if saldo_impuesto <= 0:
                retencion = 0.0
            else:
                # Este método divide entre 13 - mes
                retencion = real_payslip.calculate_r5_monthly_retention_simple(saldo_impuesto)

        # 9. Resultado final como descuento
        result = -round(retencion, 2)

except Exception:
    result = 9999
]]></field>

