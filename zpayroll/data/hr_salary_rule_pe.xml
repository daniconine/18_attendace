        <!-- GRATI_JULIO - Gratificación Legal Julio -->
        <record id="salary_rule_grati_julio" model="hr.salary.rule">
            <field name="name">Gratificación Legal Julio</field>
            <field name="code">GRATI_JULIO</field>
            <field name="sequence">19</field>
            <field name="category_id" ref="zpayroll.pe_cat_alw"/>
            <field name="active" eval="True"/>
            <field name="appears_on_payslip" eval="True"/>

            <field name="condition_select">python</field>
            <field name="condition_python"><![CDATA[
result = payslip.payroll_month_number == 7
    ]]></field>

            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
result = 0.0

year = payslip.payroll_year or False

if year and employee:

    june_slip = payslip.env['hr.payslip'].search([
        ('employee_id', '=', employee.id),
        ('payroll_year', '=', year),
        ('payroll_month_number', '=', 6),
        ('payroll_type', '=', 'nomina'),
        ('state', '!=', 'cancel'),
    ], order='id desc', limit=1)

    base_remuneracion = 0.0

    if june_slip:
        base_remuneracion = june_slip.remuneracion_computable or 0.0

    semester_slips = payslip.env['hr.payslip'].search([
        ('employee_id', '=', employee.id),
        ('payroll_year', '=', year),
        ('payroll_month_number', '>=', 1),
        ('payroll_month_number', '<=', 6),
        ('payroll_type', '=', 'nomina'),
        ('state', '!=', 'cancel'),
    ])

    meses_tomados = set()

    for slip in semester_slips:
        if slip.payroll_month_number:
            meses_tomados.add(slip.payroll_month_number)

    meses = len(meses_tomados)

    if meses > 6:
        meses = 6

    result = base_remuneracion * meses / 6.0
    ]]></field>

