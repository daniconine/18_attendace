        <!-- BASIC - Salario Proporcional -->
        <record id="salary_rule_basic" model="hr.salary.rule">
            <field name="name">Salario Proporcional</field>
            <field name="code">BASIC</field>
            <field name="sequence">1</field>
            <field name="category_id" ref="zpayroll.pe_cat_basic"/>
            <field name="active" eval="True"/>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
dias_vacaciones = worked_days.VAC.number_of_days if worked_days.VAC else 0.0
dias_permisos = worked_days.PERMISO.number_of_days if worked_days.PERMISO else 0.0

result = contract.wage * (30 - dias_vacaciones - dias_permisos) / 30
]]></field>
