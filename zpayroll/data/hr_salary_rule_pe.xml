            <field name="condition_select">python</field>
            <field name="condition_python"><![CDATA[
result = payslip.payroll_type == 'nomina'
    ]]></field>

            <field name="amount_select">code</field>
            
            <field name="amount_python_compute"><![CDATA[
if payslip.payroll_month_number != 12:
    result = -(payslip.renta_5ta_retencion or 0.0)
else:
    previous_real_income = 0.0

    previous_payslips = payslip.env['hr.payslip'].search([
        ('employee_id', '=', employee.id),
        ('payroll_year', '=', payslip.payroll_year),
        ('payroll_month_number', '<', payslip.payroll_month_number),
        ('payroll_type', 'in', ['nomina', 'gratificacion']),
        ('state', '!=', 'cancel'),
        ('id', '!=', payslip.id),
    ])

    for slip in previous_payslips:
        for line in slip.line_ids:
            rule = line.salary_rule_id

            if rule and rule.is_taxable_r5:
                previous_real_income += line.total or 0.0

    current_r5_base = BASIC + COMISION + GRATI_DICIEMBRE + BONIF_DICIEMBRE

    renta_bruta_anual_real = previous_real_income + current_r5_base

    uit = payslip.uit or 0.0
    renta_neta_imponible = renta_bruta_anual_real - (7 * uit)

    impuesto_anual = 0.0

    if uit > 0 and renta_neta_imponible > 0:
        remaining = renta_neta_imponible

        if remaining > 0:
            if remaining > (5 * uit):
                taxable_part = 5 * uit
            else:
                taxable_part = remaining

            impuesto_anual += taxable_part * 0.08
            remaining -= taxable_part

        if remaining > 0:
            if remaining > (15 * uit):
                taxable_part = 15 * uit
            else:
                taxable_part = remaining

            impuesto_anual += taxable_part * 0.14
            remaining -= taxable_part

        if remaining > 0:
            if remaining > (15 * uit):
                taxable_part = 15 * uit
            else:
                taxable_part = remaining

            impuesto_anual += taxable_part * 0.17
            remaining -= taxable_part

        if remaining > 0:
            if remaining > (10 * uit):
                taxable_part = 10 * uit
            else:
                taxable_part = remaining

            impuesto_anual += taxable_part * 0.20
            remaining -= taxable_part

        if remaining > 0:
            impuesto_anual += remaining * 0.30

    previous_withholding = 0.0

    previous_retention_slips = payslip.env['hr.payslip'].search([
        ('employee_id', '=', employee.id),
        ('payroll_year', '=', payslip.payroll_year),
        ('payroll_month_number', '<', payslip.payroll_month_number),
        ('payroll_type', '=', 'nomina'),
        ('state', '!=', 'cancel'),
        ('id', '!=', payslip.id),
    ])

    for slip in previous_retention_slips:
        for line in slip.line_ids:
            if line.code == 'R5_RET':
                previous_withholding += abs(line.total or 0.0)

    retencion_mes = impuesto_anual - previous_withholding

    if retencion_mes < 0:
        retencion_mes = 0.0

    result = -round(retencion_mes, 2)
]]></field>

