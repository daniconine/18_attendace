<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
    <record id="hr_attendance_view_form" model="ir.ui.view">
        <field name="name">hr.attendance.form.mstech</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml"><data>
            <xpath expr="//sheet" position="inside">
                <group>
                    <field name="late_minutes"/>
                    <field name="linked_leave_id"/>
                    <field name="overtime_minutes"/>
                    <field name="linked_overtime_ids"/>
                </group>
            </xpath>
</data></field>
    </record>
    
    <record id="hr_attendance_view_tree" model="ir.ui.view">
        <field name="name">hr.attendance.tree.mstech</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml"><data>
            <xpath expr="//field[@name='employee_id']" position="before">
                <button name="get_formview_action" type="object" string="Abrir" class="btn-primary"/>
            </xpath>
</data></field>
    </record>
</data></odoo>
