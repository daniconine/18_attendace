<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
    <record id="hr_leave_view_form" model="ir.ui.view">
        <field name="name">hr.leave.form.mstech</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml"><data>
            <xpath expr="//field[@name='holiday_status_id']" position="after">
                <field name="payslip_status"/>
            </xpath>
</data></field>
    </record>
    
    <record id="hr_leave_view_tree" model="ir.ui.view">
        <field name="name">hr.leave.tree.mstech</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree_my"/>
        <field name="arch" type="xml"><data>
            <xpath expr="//field[@name='duration_display']" position="after">
                <field name="payslip_status"/>
            </xpath>
</data></field>
    </record>
</data></odoo>
