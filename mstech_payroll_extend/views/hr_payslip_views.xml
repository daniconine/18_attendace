        -->
        <record id="hr_payslip_view_form" model="ir.ui.view">
            <field name="name">hr.payslip.form.mstech</field>
            <field name="model">hr.payslip</field>
            <field name="inherit_id" ref="hr_payroll_community.hr_payslip_view_form"/>
            <field name="arch" type="xml"><data>
                <xpath expr="//field[@name='credit_note']" position="after">
                    <field name="is_liquidation"/>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page name="analytic_cost" string="Costo Analítico">
                        <field name="analytic_cost_line_ids" context="{'default_payslip_id': id}"/>
                    </page>
                </xpath>
                <xpath expr="//field[@name='worked_days_line_ids']/list//field[@name='name']" position="after">
                    <field name="work_entry_type_id"/>
                </xpath>
                <xpath expr="//field[@name='worked_days_line_ids']/list//field[@name='name']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
                <xpath expr="//field[@name='line_ids']/list//field[@name='code']" position="after">
                    <field name="plame_code" string="PLAME"/>
                </xpath>
                <xpath expr="//field[@name='line_ids']/form//field[@name='code']" position="after">
                    <field name="plame_code" string="PLAME"/>
                </xpath>
</data></field>
        </record>
    </data>
</odoo>
