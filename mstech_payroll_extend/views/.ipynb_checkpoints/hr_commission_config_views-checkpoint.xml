<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
    <record id="hr_commission_config_view_form" model="ir.ui.view">
        <field name="name">hr.commission.config.form</field>
        <field name="model">hr.commission.config</field>
        <field name="arch" type="xml">
            <form string="Plan de Comisiones">
                <header>
                    <button string="Activar plan" name="activate_plan" type="object" class="btn-primary" invisible="active"/>
                    <button string="Desactivar plan" name="deactivate_plan" type="object" class="btn-secondary" invisible="not active"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre del Plan de Comisión" readonly="active"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="model_id"  readonly="active"/>
                            <field name="domain"  readonly="active"/>
                            <field name="code_executor_id"  readonly="active"/>
                            <field name="model_name" invisible="1"  readonly="active"/>
                        </group>
                        <group>
                            <field name="employee_field_name"  readonly="active"/>
                            <field name="amount_base_field_name"  readonly="active"/>
                            <field name="currency_field_name"  readonly="active"/>
                            <field name="date_field_name"  readonly="active"/>
                        </group>
                        <group>
                            <field name="payslip_description"  readonly="active"/>
                            <field name="payslip_code"  readonly="active"/>
                        </group>
                        <group>
                            <field name="action_create_id" invisible="1"/>
                            <field name="action_update_id" invisible="1"/>
                            <field name="action_unlink_id" invisible="1"/>
                            <field name="automation_create_id"  readonly="active"/>
                            <field name="automation_update_id"  readonly="active"/>
                            <field name="automation_unlink_id"  readonly="active"/>
                        </group>
                        <group>
                            <field name="python_code" widget="ace" options="{'mode': 'python'}"  readonly="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_commission_config_view_tree" model="ir.ui.view">
        <field name="name">hr.commission.config.tree</field>
        <field name="model">hr.commission.config</field>
        <field name="arch" type="xml">
            <list string="Plan de Comisión">
                <field name="active"/>
                <field name="name"/>
                <field name="model_id"/>
            </list>
        </field>
    </record>

    <record id="hr_commission_config_action" model="ir.actions.act_window">
        <field name="name">Plan de Comisión</field>
        <field name="res_model">hr.commission.config</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('active', 'in', [True, False])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea una nueva Plantilla de Bonos
            </p>
        </field>
    </record>
</data></odoo>
