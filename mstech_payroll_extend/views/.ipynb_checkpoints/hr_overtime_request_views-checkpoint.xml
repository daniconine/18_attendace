<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
    <record id="hr_overtime_request_view_form" model="ir.ui.view">
        <field name="name">hr.overtime.request.form</field>
        <field name="model">hr.overtime.request</field>
        <field name="arch" type="xml">
            <form string="Solicitud de Horas Extras">
                <header>
                    <button string="Enviar" name="action_submit" type="object" class="btn-primary"/>
                    <button string="Aprobar" name="action_approve" type="object" class="btn-primary" invisible="state in ['approved','rejected']"/>
                    <button string="Rechazar" name="action_reject" type="object" class="btn-secondary" invisible="state in ['approved','rejected']"/>
                    <button string="Reestablecer a borrador" name="action_reset_to_draft" type="object" class="btn-secondary" invisible="state in ['draft']"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="overtime_type"/>
                            <field name="reason"/>
                        </group>
                        <group>
                            <field name="responsible_id"/>
                            <field name="work_entry_type_id"/>
                            <field name="approved_work_entry_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_overtime_request_view_tree" model="ir.ui.view">
        <field name="name">hr.overtime.request.tree</field>
        <field name="model">hr.overtime.request</field>
        <field name="arch" type="xml">
            <list string="Solicitud de Horas Extras">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="hr_overtime_request_action" model="ir.actions.act_window">
        <field name="name">Solicitud de Horas Extras</field>
        <field name="res_model">hr.overtime.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aun no hay solicitudes creadas.
            </p>
        </field>
    </record>
</data></odoo>
