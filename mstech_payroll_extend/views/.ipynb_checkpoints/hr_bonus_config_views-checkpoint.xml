<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
    <record id="hr_bonus_config_view_form" model="ir.ui.view">
        <field name="name">hr.bonus.config.form</field>
        <field name="model">hr.bonus.config</field>
        <field name="arch" type="xml">
            <form string="Plantilla de bonos">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre de la plantilla"/>
                        </h1>
                    </div>
                    <group name="main_group">
                        <group name="payslip_data">
                            <field name="active" invisible="1"/>
                            <field name="payslip_description"/>
                            <field name="payslip_code"/>
                            <field name="company_id"/>
                            <field name="company_currency_id" invisible="1"/>
                        </group>
                        <group name="amounts">
                            <field name="bonus_type"/>
                            <field name="amount_fixed" invisible="bonus_type not in ['fixed']"/>
                            <field name="code_executor_id" invisible="bonus_type not in ['variable']"/>
                        </group>
                        <group name="automation">
                            <field name="recurrence"/>
                            <field name="next_execution_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="bonuses" string="Bonos Generados">
                            <field name="bonus_ids"/>
                            <label for="bonuses_count"/>
                            <field name="bonuses_count"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_bonus_config_view_tree" model="ir.ui.view">
        <field name="name">hr.bonus.config.tree</field>
        <field name="model">hr.bonus.config</field>
        <field name="arch" type="xml">
            <list string="Plantilla de Bonos">
                <field name="name"/>
                <field name="payslip_code"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="hr_bonus_config_action" model="ir.actions.act_window">
        <field name="name">Plantilla de Bonos</field>
        <field name="res_model">hr.bonus.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea una nueva Plantilla de Bonos
            </p>
        </field>
    </record>
</data></odoo>
