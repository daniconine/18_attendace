<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
    <record id="view_company_form" model="ir.ui.view">
        <field name="name">res.company.form.mstech</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml"><data>
            <xpath expr="//notebook" position="inside">
                <page name="pe_payroll" string="Planilla Perú">
                    <group name="pe_legal_representative" string="Representante legal">
                        <field name="legal_representative_id"/>
                        <field name="legal_rep_dni"/>
                        <field name="legal_rep_position"/>
                        <field name="legal_rep_signature" widget="signature"/>
                    </group>
                    <group name="pe_internal_policies" string="Políticas internas">
                        <field name="enforce_commission_in_soles"/>
                        <field name="discount_holidays_on_vac"/>
                        <field name="discount_day_31_on_vac"/>
                        <field name="min_vacation_days"/>
                        <field name="discount_unpaid_days_in_quincena"/>
                    </group>
                    <group name="pe_utilities" string="Utilidades">
                        <field name="activity_utilities_id"/>
                    </group>
                    <group name="pe_analytic_dist" string="Distribución Analítica">
                        <field name="enable_payroll_analytic_distribution"/>
                    </group>
                </page>
            </xpath>
</data></field>
    </record>
</data></odoo>
