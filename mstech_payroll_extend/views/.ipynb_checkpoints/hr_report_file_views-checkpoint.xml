<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_report_file_view_form" model="ir.ui.view">
            <field name="name">hr.report.file.form</field>
            <field name="model">hr.report.file</field>
            <field name="arch" type="xml">
                <form string="Archivo de Reporte de Nómina Generado">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Nombre de Columna"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="payslip_run_id"/>
                                <field name="file_data" filename="file_name"/>
                                <field name="file_name"/>
                            </group>
                            <group>
                                <field name="generation_date"/>
                                <field name="generated_by_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <record id="hr_report_file_view_tree" model="ir.ui.view">
            <field name="name">hr.report.file.tree</field>
            <field name="model">hr.report.file</field>
            <field name="arch" type="xml">
                <list string="Línea/Columna">
                    <field name="name"/>
                    <field name="file_name"/>
                    <button name="action_download_file" type="object" class="btn-primary" string="Descargar"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
