<odoo>
    <!-- =============================================== -->
    <!-- VISTA FORMULARIO PARA HR.ATTENDANCE.IMPORT      -->
    <!-- =============================================== -->
    <record id="view_hr_attendance_import_form" model="ir.ui.view">
        <field name="name">hr.attendance.import.form</field>
        <field name="model">hr.attendance.import</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Botones de acciones que aparecen según el estado -->
                    <button name="action_read_file" string="Leer Archivo" type="object" class="btn-primary"
                            invisible="state not in ['draft']"/>
                    <button name="action_validate_lines" string="Validar Líneas" type="object" class="btn-primary"
                            invisible="state not in ['read', 'error']"/>
                    <button name="action_create_attendances" string="Crear Asistencias" type="object" class="btn-primary"
                            invisible="state not in ['validated']"/>
                    <button name="action_reset_to_draft" string="Reestablecer a Borrador" type="object"
                            confirm="¿Está seguro de que desea borrar todas las líneas y empezar de nuevo?"
                            invisible="state not in ['read', 'error', 'validated']"/>
                    
                    <!-- Barra de estado -->
                    <field name="state" widget="statusbar" statusbar_visible="draft,read,validated,done"/>
                </header>
                <sheet>
                    <!-- Título H1 -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- Campos principales en 2 columnas -->
                    <group>
                        <group>
                            <field name="year" readonly="state not in ['draft']"/>
                            <field name="month" readonly="state not in ['draft']"/>
                            <field name="location_id" readonly="state not in ['draft']"/>
                        </group>
                        <group>
                            <field name="file_data" widget="binary" filename="file_name_placeholder"
                                   readonly="state not in ['draft']"/>
                            <field name="sheet_name" readonly="state not in ['draft']"/>
                            <field name="file_name_placeholder" invisible="1"/> <!-- Campo técnico para el widget binary -->
                        </group>
                    </group>
                    
                    <!-- Pestañas para las líneas y el log -->
                    <notebook>
                        <page string="Registros de Asistencia">
                            <field name="line_ids" readonly="state in ['done']">
                                <list editable="bottom" decoration-danger="state == 'error'" decoration-warning="conflicting_register">
                                    <field name="row_index"/>
                                    <field name="zkteco_id_raw"/>
                                    <field name="employee_name_raw"/>
                                    <field name="day_str"/>
                                    <field name="check_in_str_raw" optional="show"/>
                                    <field name="check_out_str_raw" optional="show"/>
                                    <field name="check_in" optional="show" readonly="state in ['done']"/>
                                    <field name="check_out" optional="show" readonly="state in ['done']"/>
                                    <field name="employee_id"/>
                                    <field name="state"/>
                                    <field name="error_message"/>
                                    <field name="conflicting_register" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Registro de Eventos">
                            <field name="log" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                
                <!-- Chatter al final del formulario -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- =============================================== -->
    <!-- VISTA ÁRBOL Y ACCIÓN (SIN CAMBIOS SIGNIFICATIVOS) -->
    <!-- =============================================== -->
    <record id="view_hr_attendance_import_tree" model="ir.ui.view">
        <field name="name">hr.attendance.import.tree</field>
        <field name="model">hr.attendance.import</field>
        <field name="arch" type="xml">
            <list decoration-warning="state=='read'" decoration-info="state=='validated'" decoration-success="state=='done'" decoration-danger="state=='error'">
                <field name="name"/>
                <field name="location_id"/>
                <field name="state"/>
                <field name="log" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_hr_attendance_import" model="ir.actions.act_window">
        <field name="name">Importar Asistencias</field>
        <field name="res_model">hr.attendance.import</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>