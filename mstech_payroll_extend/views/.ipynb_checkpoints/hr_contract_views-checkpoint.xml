<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
    <record id="hr_contract_view_form" model="ir.ui.view">
        <field name="name">hr.contract.form.mstech</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml"><data>
            <xpath expr="//notebook" position="inside">
                <page string="Perú" name="peru">
                    <group>
                        <group name="pe_general" string="General">
                            <field name="pe_labor_regime_id"/>
                            <field name="pe_pension_scheme"/>
                            <field name="afp_id"/>
                            <field name="afp_commission_type"/>
                            <field name="pe_health_scheme"/>
                        </group>
                        <group name="pe_other" string="Otros conceptos">
                            <field name="food_allowance"/>
                            <field name="productivity_bonus"/>
                            <field name="eps_cost"/>
                            <field name="mobility_allowance"/>
                            <field name="sctr_table"/>
                            <field name="has_atypical_hours"/>
                            <field name="has_maximum_hours"/>
                            <field name="has_night_hours"/>
                            <field name="is_unionized"/>
                        </group>
                        <group name="pe_discount" string="Descuentos">
                            <field name="judicial_deduction_type"/>
                            <field name="judicial_deduction_amount"/>
                        </group>
                        <group name="pe_rent" string="Cálculo de la renta de 5ta">
                            <field name="receives_commissions"/>
                            <field name="estimated_monthly_bonuses"/>
                            <field name="estimated_commissions"/>
                            <field name="previous_income_total"/>
                            <field name="previous_rent5_held"/>
                        </group>
                        <group name="pe_leaves" string="Tardanzas">
                            <field name="overtime_tolerance_minutes"/>
                            <field name="overtime_generation_tolerance"/>
                            <field name="tardiness_type_1h"/>
                            <field name="tardiness_type_2h"/>
                            <field name="tardiness_type_more"/>
                        </group>
                        <group name="pe_leaves" string="Tiempos compensatorios">
                            <field name="compensatory_hours_balance"/>
                            <field name="vacation_days_balance"/>
                            <field name="last_vacation_accrual_date"/>
                            <field name="is_trusted_employee"/>
                            <field name="special_situation" invisible="not is_trusted_employee"/>
                            <field name="allow_vacation_advance"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//group[@name='salary']" position="inside">
                <field name="bank_id"/>
                <field name="bank_account_number"/>
                <field name="bank_account_currency" options="{'no_open': True, 'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='contract_type_id']" position="after">
                <field name="formative_modality_id"/>
            </xpath>
            <xpath expr="//field[@name='job_id']" position="after">
                <field name="job_occupation_id"/>
            </xpath>
</data></field>
    </record>
</data></odoo>
