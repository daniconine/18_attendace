<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_employee_form" model="ir.ui.view">
            <field name="name">hr.employee.form.mstech</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml"><data>
                <xpath expr="//field[@name='identification_id']" position="after">
                    <field name="cuspp"/>
                </xpath>
                <xpath expr="//field[@name='gender']" position="after">
                    <field name="is_disabled_person"/>
                    <field name="is_family_mother"/>
                </xpath>
                <xpath expr="//field[@name='marital']" position="after">
                    <field name="family_ids"/>
                </xpath>
                <xpath expr="//field[@name='children']" position="after">
                    <field name="dependent_children_count"/>
                    <field name="disabled_children_count"/>
                    <field name="student_children_count"/>
                </xpath>
                <xpath expr="//field[@name='certificate']" position="after">
                    <field name="study_school_type"/>
                    <field name="educational_situation"/>
                </xpath>
                <xpath expr="//field[@name='employee_type']" position="after">
                    <field name="pensioner_type"/>
                </xpath>
                <xpath expr="//field[@name='identification_id']" position="before">
                    <field name="document_type_id"/>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page string="Declaración 5ta" name="declaracion_5ta_page">
                        <group>
                            <button name="button_create_declaracion_5ta" type="object" string="Nueva Declaración" class="btn-primary" invisible="1"/>
                        </group>
                        <field name="declaracion_5ta_ids">
                            <list editable="bottom" delete="0" default_order="fiscal_year desc, state desc, id desc">
                                <button name="get_formview_action" type="object" string="Abrir" class="btn-primary"/>
                                <field name="fiscal_year" readonly="state not in ['draft']"/>
                                <field name="external_revenue" readonly="state not in ['draft']"/>
                                <field name="external_amount" readonly="state not in ['draft']"/>
                                <field name="retention_partner_id" readonly="state not in ['draft']"/>
                                <field name="state" readonly="1"/>
                            </list>
                        </field>
                    </page>
                </xpath>
</data></field>
        </record>
    </data>
</odoo>
