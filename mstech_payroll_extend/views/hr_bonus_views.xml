<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
    <record id="hr_bonus_view_form" model="ir.ui.view">
        <field name="name">hr.bonus.form</field>
        <field name="model">hr.bonus</field>
        <field name="arch" type="xml">
            <form string="Bono de Empleado">
                <header>
                    <button string="Cancelar" name="action_cancel" type="object" class="btn-secondary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Referencia"/>
                        </h1>
                    </div>
                    <group name="main_group">
                        <group>
                            <field name="employee_id"/>
                            <field name="config_id"/>
                            <field name="payslip_description"/>
                            <field name="payslip_code"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="date"/>
                            <field name="payslip_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_bonus_view_tree" model="ir.ui.view">
        <field name="name">hr.bonus.tree</field>
        <field name="model">hr.bonus</field>
        <field name="arch" type="xml">
            <list string="Bonos de Empleados">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="config_id"/>
                <field name="payslip_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="hr_bonus_action" model="ir.actions.act_window">
        <field name="name">Bono de Empleado</field>
        <field name="res_model">hr.bonus</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea un nuevo Bono de empleado
            </p>
        </field>
    </record>
</data></odoo>
