<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
        <record id="hr_payslip_run_form" model="ir.ui.view">
            <field name="name">hr.payslip.run.form.mstech</field>
            <field name="model">hr.payslip.run</field>
            <field name="inherit_id" ref="hr_payroll_community.hr_payslip_run_form"/>
        -->
        <record id="hr_payslip_run_view_form" model="ir.ui.view">
            <field name="name">hr.payslip.run.form.mstech</field>
            <field name="model">hr.payslip.run</field>
            <field name="inherit_id" ref="hr_payroll_community.hr_payslip_run_view_form"/>
            <field name="arch" type="xml"><data>
                <xpath expr="//field[@name='credit_note']" position="before">
                    <field name="company_id"/>
                    <field name="regulatory_report_template_ids" widget="many2many_tags"/>
                </xpath>
                <xpath expr="//field[@name='credit_note']" position="after">
                    <field name="is_analytic_distribution_enabled"/>
                </xpath>
                <xpath expr="//field[@name='slip_ids']/preceding-sibling::separator[1]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//sheet" position="inside">
                    <notebook>
                        <page name="payslips" string="Nóminas">
                            <field name="slip_ids" position="move"/>
                        </page>
                        <page name="pe_pending_overtimes" string="Horas Extras Pendientes">
                            <label for="date_cutoff_overtime"/>
                            <field name="date_cutoff_overtime"/>
                            <field name="pending_overtime_ids"/>
                        </page>
                        <page name="pe_pending_leaves" string="Ausencias Pendientes">
                            <label for="date_cutoff_leaves"/>
                            <field name="date_cutoff_leaves"/>
                            <field name="pending_leave_ids"/>
                        </page>
                        <page name="pe_pending_bonuses" string="Bonos Pendientes">
                            <label for="date_cutoff_bonuses"/>
                            <field name="date_cutoff_bonuses"/>
                            <field name="pending_bonus_ids"/>
                        </page>
                        <page name="pe_pending_commissions" string="Comisiones Pendientes">
                            <label for="date_cutoff_commissions"/>
                            <field name="date_cutoff_commissions"/>
                            <field name="pending_commission_ids"/>
                        </page>
                        <page name="pe_generated_reports" string="Archivos generados">
                            <field name="generated_file_ids" readonly="1"/>
                        </page>
                    </notebook>
                </xpath>
</data></field>
        </record>
    </data>
</odoo>
