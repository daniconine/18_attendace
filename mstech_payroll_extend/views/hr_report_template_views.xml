<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
    <record id="hr_report_template_view_form" model="ir.ui.view">
        <field name="name">hr.report.template.form</field>
        <field name="model">hr.report.template</field>
        <field name="arch" type="xml">
            <form string="Plantilla para Generador de Reportes de Nómina">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre de la Plantilla"/>
                        </h1>
                    </div>
                    <group>
                        <field name="filename" placeholder="Opcional. Use una expresión de python"/>
                        <field name="file_extension"/>
                        <field name="delimiter"/>
                        <field name="iterator" placeholder="Opcional. Defina un campo válido de payslip"/>
                        <field name="is_bank_payment"/>
                    </group>
                    <notebook>
                        <page name="line_ids" string="Columnas">
                            <field name="line_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_report_template_view_tree" model="ir.ui.view">
        <field name="name">hr.report.template.tree</field>
        <field name="model">hr.report.template</field>
        <field name="arch" type="xml">
            <list string="Plantilla para Generador de Reportes de Nómina">
                <field name="name"/>
                <field name="file_extension"/>
            </list>
        </field>
    </record>

    <record id="hr_report_template_action" model="ir.actions.act_window">
        <field name="name">Plantilla para Generador de Reportes de Nómina</field>
        <field name="res_model">hr.report.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea una nueva Plantilla.
            </p>
        </field>
    </record>
</data></odoo>
