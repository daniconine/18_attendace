<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
    <record id="hr_labor_regime_pe_view_tree" model="ir.ui.view">
        <field name="name">hr.labor.regime.pe.tree</field>
        <field name="model">hr.labor.regime.pe</field>
        <field name="arch" type="xml">
            <list string="Régimen Laboral" editable="top">
                <field name="name"/>
                <field name="code"/>
                <field name="plame_code"/>
                <field name="annual_vacation_days"/>
                <field name="receives_gratification"/>
            </list>
        </field>
    </record>

    <record id="hr_labor_regime_pe_action" model="ir.actions.act_window">
        <field name="name">Régimen Laboral (Perú)</field>
        <field name="res_model">hr.labor.regime.pe</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aun no hay registros creados.
            </p>
        </field>
    </record>
</data></odoo>
