<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
    <record id="hr_afp_rate_view_tree" model="ir.ui.view">
        <field name="name">hr.afp.rate.tree</field>
        <field name="model">hr.afp.rate</field>
        <field name="arch" type="xml">
            <list string="Tasas Mensuales de AFP" editable="top">
                <field name="afp_id"/>
                <field name="date_from"/>
                <field name="mandatory_contribution_rate"/>
                <field name="insurance_premium_rate"/>
                <field name="commission_rate"/>
            </list>
        </field>
    </record>

    <record id="hr_afp_rate_action" model="ir.actions.act_window">
        <field name="name">Tasas Mensuales de AFP</field>
        <field name="res_model">hr.afp.rate</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aun no hay registros creados.
            </p>
        </field>
    </record>
</data></odoo>
