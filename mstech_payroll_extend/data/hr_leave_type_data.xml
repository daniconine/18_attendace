<!-- mstech_payroll_extend/data/hr_leave_type_data.xml -->
<odoo>
    <data noupdate="0">
        <!-- ============================================================== -->
        <!-- ➤ AUSENCIAS VINCULADAS A NUESTRA LÓGICA DE SALDOS            -->
        <!-- ============================================================== -->

        <!-- 1. Vacaciones Regulares -->
        <record id="leave_type_vacation_regular_pe" model="hr.leave.type">
            <field name="name">Vacaciones Regulares</field>
            <field name="request_unit">day</field>
            <field name="work_entry_type_id" ref="mstech_payroll_extend.hr_work_entry_type_vacation_regular"/>
            <!--<field name="requires_attachment">False</field>-->
            <field name="support_document">False</field>
            <!-- ➤ MAPEO A PLAME -->
            <field name="plame_suspension_type_id" ref="mstech_payroll_extend.plame_suspension_type_vacation"/>
        </record>

        <!-- 2. Adelanto de Vacaciones -->
        <record id="leave_type_vacation_advance_pe" model="hr.leave.type">
            <field name="name">Adelanto de Vacaciones</field>
            <field name="request_unit">day</field>
            <field name="work_entry_type_id" ref="mstech_payroll_extend.hr_work_entry_type_vacation_advance"/>
            <!--<field name="requires_attachment">False</field>-->
            <field name="support_document">False</field>
            <!-- ➤ MAPEO A PLAME -->
            <field name="plame_suspension_type_id" ref="mstech_payroll_extend.plame_suspension_type_vacation"/>
        </record>

        <!-- 3. Permiso a cuenta de Vacaciones -->
        <record id="leave_type_on_vacation_account_pe" model="hr.leave.type">
            <field name="name">Permiso a Cuenta de Vacaciones</field>
            <field name="request_unit">day</field>
            <field name="work_entry_type_id" ref="mstech_payroll_extend.hr_work_entry_type_vacation_regular"/>
            <!--<field name="requires_attachment">False</field>-->
            <field name="support_document">False</field>
            <!-- ➤ MAPEO A PLAME -->
            <field name="plame_suspension_type_id" ref="mstech_payroll_extend.plame_suspension_type_vacation"/>
        </record>

        <!-- 4. Permiso Compensatorio -->
        <record id="leave_type_compensatory_pe" model="hr.leave.type">
            <field name="name">Permiso Compensatorio</field>
            <field name="request_unit">hour</field>
            <field name="work_entry_type_id" ref="mstech_payroll_extend.hr_work_entry_type_compensated_leave"/>
            <!--<field name="requires_attachment">False</field>-->
            <field name="support_document">False</field>
            <!-- Los permisos compensatorios no suelen tener un código específico en PLAME, se consideran tiempo trabajado. No se mapea. -->
        </record>

        <!-- ============================================================== -->
        <!-- ➤ LICENCIAS PAGADAS / SUBSIDIADAS (NO DESCUENTAN SALARIO)    -->
        <!-- ============================================================== -->

        <!-- 5. Licencia por Maternidad -->
        <record id="leave_type_maternity_pe" model="hr.leave.type">
            <field name="name">Licencia por Maternidad</field>
            <field name="request_unit">day</field>
            <field name="work_entry_type_id" ref="hr_work_entry_contract.work_entry_type_sick_leave"/>
            <!--<field name="requires_attachment">True</field>-->
            <field name="support_document">True</field>
            <!-- ➤ MAPEO A PLAME -->
            <field name="plame_suspension_type_id" ref="mstech_payroll_extend.plame_suspension_type_maternity"/>
        </record>

        <!-- 6. Licencia por Paternidad -->
        <record id="leave_type_paternity_pe" model="hr.leave.type">
            <field name="name">Licencia por Paternidad</field>
            <field name="request_unit">day</field>
            <field name="work_entry_type_id" ref="hr_work_entry_contract.work_entry_type_sick_leave"/>
            <!--<field name="requires_attachment">True</field>-->
            <field name="support_document">True</field>
            <!-- ➤ MAPEO A PLAME -->
            <field name="plame_suspension_type_id" ref="mstech_payroll_extend.plame_suspension_type_paternity"/>
        </record>

        <!-- 7. Descanso Médico Subsidiado -->
        <record id="leave_type_sick_subsidized_pe" model="hr.leave.type">
            <field name="name">Descanso Médico Subsidiado</field>
            <field name="request_unit">day</field>
            <field name="work_entry_type_id" ref="hr_work_entry_contract.work_entry_type_sick_leave"/>
            <!--<field name="requires_attachment">True</field>-->
            <field name="support_document">True</field>
            <!-- ➤ MAPEO A PLAME -->
            <field name="plame_suspension_type_id" ref="mstech_payroll_extend.plame_suspension_type_accident"/>
        </record>
        
        <!-- 8. Licencia por fallecimiento de familiar -->
        <record id="leave_type_bereavement_pe" model="hr.leave.type">
            <field name="name">Licencia por Fallecimiento de Familiar</field>
            <field name="request_unit">day</field>
            <field name="work_entry_type_id" ref="hr_work_entry_contract.work_entry_type_leave"/>
            <!--<field name="requires_attachment">True</field>-->
            <field name="support_document">True</field>
            <!-- Este es un permiso pagado por ley, pero para PLAME se reporta como un permiso sin goce,
                 ya que no es una "suspensión imperfecta" subsidiada. Se ajusta en el cálculo de la nómina.
                 Opcionalmente se puede omitir si no se quiere reportar. -->
            <field name="plame_suspension_type_id" ref="mstech_payroll_extend.plame_suspension_type_unpaid_leave"/>
        </record>

        <!-- ============================================================== -->
        <!-- ➤ PERMISOS ESPECIALES Y NO PAGADOS                           -->
        <!-- ============================================================== -->
        
        <!-- 9. Permiso Especial (Con Goce de Haber) -->
        <record id="leave_type_special_paid_pe" model="hr.leave.type">
            <field name="name">Permiso Especial (Con Goce de Haber)</field>
            <field name="request_unit">hour</field>
            <field name="work_entry_type_id" ref="hr_work_entry_contract.work_entry_type_leave"/>
            <!--<field name="requires_attachment">False</field>-->
            <field name="support_document">False</field>
            <!-- Al ser un permiso corto y con goce, no se reporta como suspensión en PLAME. -->
        </record>

        <!-- 10. Licencia sin Goce de Haber (No Pagada) -->
        <record id="leave_type_unpaid_pe" model="hr.leave.type">
            <field name="name">Licencia sin Goce de Haber</field>
            <field name="request_unit">day</field>
            <field name="work_entry_type_id" ref="hr_work_entry_contract.work_entry_type_unpaid_leave"/>
            <!--<field name="requires_attachment">False</field>-->
            <field name="support_document">False</field>
            <!-- ➤ MAPEO A PLAME -->
            <field name="plame_suspension_type_id" ref="mstech_payroll_extend.plame_suspension_type_unpaid_leave"/>
        </record>

        <!-- 11. Trabajo en Día Feriado -->
        <record id="leave_type_work_on_holiday_pe" model="hr.leave.type">
            <field name="name">Trabajo en Día Feriado</field>
            <field name="request_unit">day</field>
            <field name="work_entry_type_id" ref="mstech_payroll_extend.work_entry_type_holiday_pe"/>
            <!--<field name="leave_type">with_salary</field>-->
            <field name="time_type">other</field>
            <!--<field name="requires_attachment">False</field>-->
            <field name="support_document">False</field>
            <!-- No se mapea a PLAME porque no es una suspensión, es un día trabajado especial. -->
        </record>

        <!-- 12. Falta Injustificada -->
        <record id="leave_type_unjustified_absence_pe" model="hr.leave.type">
            <field name="name">Falta Injustificada</field>
            <field name="request_unit">day</field>
            <field name="work_entry_type_id" ref="hr_work_entry_contract.work_entry_type_unpaid_leave"/>
            <!--<field name="requires_attachment">False</field>-->
            <field name="support_document">False</field>
            <!-- ➤ MAPEO A PLAME -->
            <field name="plame_suspension_type_id" ref="mstech_payroll_extend.plame_suspension_type_unjustified"/>
        </record>

        <!-- 13. Tardanzas -->
        <!-- probablemente solo se use un tipo de tardanza genérico, que se acumulará y será descontado -->
        <record id="leave_type_generic_late_arrivals_pe" model="hr.leave.type">
            <field name="name">Tardanza</field>
            <field name="request_unit">hour</field>
            <field name="leave_validation_type">no_validation</field>
            <field name="requires_allocation">no</field>
            <field name="time_type">leave</field>
            <field name="work_entry_type_id" ref="hr_work_entry_type_tardiness_min"/>
            <field name="support_document">False</field>
        </record>
    </data>
</odoo>