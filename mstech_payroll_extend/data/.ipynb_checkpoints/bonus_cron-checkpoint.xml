<!-- mstech_payroll_extend/data/bonus_cron.xml -->
<odoo>
    <data noupdate="0">
        <record id="cron_generate_bonuses_pe" model="ir.cron">
            <field name="name">Planilla PE: Generación Automática de Bonos</field>
            <!-- Usamos el modelo que tiene el método -->
            <field name="model_id" ref="mstech_payroll_extend.model_hr_bonus_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_bonuses()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>