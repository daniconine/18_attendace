<!-- mstech_payroll_extend/data/hr_rule_parameter_data.xml -->
<odoo>
    <data noupdate="0">
        <!-- ========================================================== -->
        <!-- PARÁMETROS GENERALES Y TRIBUTARIOS                         -->
        <!-- ========================================================== -->
        <record id="param_uit" model="hr.rule.parameter">
            <field name="name">Unidad Impositiva Tributaria</field><field name="code">l10n_pe_uit</field>
        </record>
        <record id="param_uit_v2023" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_uit"/><field name="date_from">2023-01-01</field><field name="value">4950</field></record>
        <record id="param_uit_v2024" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_uit"/><field name="date_from">2024-01-01</field><field name="value">5150</field></record>
        <record id="param_uit_v2025" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_uit"/><field name="date_from">2025-01-01</field><field name="value">5350</field></record>

        <record id="param_rmv" model="hr.rule.parameter">
            <field name="name">Remuneración Mínima Vital</field><field name="code">l10n_pe_rmv</field>
        </record>
        <record id="param_rmv_v2022" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_rmv"/><field name="date_from">2022-05-01</field><field name="value">1025</field></record>

        <record id="param_asig_familiar" model="hr.rule.parameter">
            <field name="name">Asignación Familiar</field><field name="code">l10n_pe_asignacion_familiar</field>
        </record>
        <record id="param_asig_familiar_v2022" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_asig_familiar"/><field name="date_from">2022-05-01</field><field name="value">102.50</field></record>

        <!-- ========================================================== -->
        <!-- APORTES EMPLEADOR (ESSALUD, SCTR, SEGUROS)                 -->
        <!-- ========================================================== -->
        <record id="param_essalud" model="hr.rule.parameter">
            <field name="name">EsSalud - Regular (%)</field><field name="code">l10n_pe_essalud_regular</field>
        </record>
        <record id="param_essalud_v1" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_essalud"/><field name="date_from">1900-01-01</field><field name="value">0.09</field></record>

        <record id="param_eps" model="hr.rule.parameter">
            <field name="name">Crédito EsSalud por EPS (%)</field><field name="code">l10n_pe_eps</field>
        </record>
        <record id="param_eps_v1" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_eps"/><field name="date_from">1900-01-01</field><field name="value">0.0225</field></record> <!-- 25% del 9% de EsSalud -->

        <record id="param_sctr_priv_porcentaje" model="hr.rule.parameter">
            <field name="name">SCTR Privado Porcentaje (%)</field><field name="code">l10n_pe_sctr_privado_porcentaje</field>
        </record>
        <record id="param_sctr_priv_porcentaje_v1" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_sctr_priv_porcentaje"/><field name="date_from">1900-01-01</field><field name="value">1.53</field></record> <!-- Valor referencial, varía por riesgo -->

        <record id="param_sctr_pub_porcentaje" model="hr.rule.parameter">
            <field name="name">SCTR Público Porcentaje (%)</field><field name="code">l10n_pe_sctr_publico_porcentaje</field>
        </record>
        <record id="param_sctr_pub_porcentaje_v1" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_sctr_pub_porcentaje"/><field name="date_from">1900-01-01</field><field name="value">0.53</field></record> <!-- Valor referencial -->

        <record id="param_sctr_priv_fijo" model="hr.rule.parameter">
            <field name="name">SCTR Privado Monto fijo</field><field name="code">l10n_pe_sctr_privado_monto_fijo</field>
        </record>
        <record id="param_sctr_priv_fijo_v1" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_sctr_priv_fijo"/><field name="date_from">1900-01-01</field><field name="value">0.00</field></record> <!-- Generalmente es por porcentaje -->

        <record id="param_sctr_pub_fijo" model="hr.rule.parameter">
            <field name="name">SCTR Público Monto fijo</field><field name="code">l10n_pe_sctr_publico_monto_fijo</field>
        </record>
        <record id="param_sctr_pub_fijo_v1" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_sctr_pub_fijo"/><field name="date_from">1900-01-01</field><field name="value">0.00</field></record>
        
        <record id="param_poliza" model="hr.rule.parameter">
            <field name="name">Póliza de seguro Vida Ley</field><field name="code">l10n_pe_poliza_de_seguro</field>
        </record>
        <record id="param_poliza_v1" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_poliza"/><field name="date_from">1900-01-01</field><field name="value">5.00</field></record> <!-- Valor referencial, varía por aseguradora -->

        <record id="param_senati" model="hr.rule.parameter">
            <field name="name">SENATI (%)</field><field name="code">l10n_pe_senati</field>
        </record>
        <record id="param_senati_v1" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_senati"/><field name="date_from">1900-01-01</field><field name="value">0.0075</field></record>

        <record id="param_sis" model="hr.rule.parameter">
            <field name="name">Seguro Integral de Salud</field><field name="code">l10n_pe_seguro_integral_salud</field>
        </record>
        <record id="param_sis_v1" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_sis"/><field name="date_from">1900-01-01</field><field name="value">15.00</field></record> <!-- Para trabajadores independientes o regímenes especiales -->
        
        <!-- ========================================================== -->
        <!-- HORAS EXTRAS (% DE RECARGO)                                -->
        <!-- ========================================================== -->
        <record id="param_hex_1" model="hr.rule.parameter">
            <field name="name">Recargo Horas extras Primer tramo (%)</field><field name="code">l10n_pe_horas_extras_1</field>
        </record>
        <record id="param_hex_1_v1" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_hex_1"/><field name="date_from">1900-01-01</field><field name="value">0.25</field></record>

        <record id="param_hex_2" model="hr.rule.parameter">
            <field name="name">Recargo Horas extras Segundo tramo (%)</field><field name="code">l10n_pe_horas_extras_2</field>
        </record>
        <record id="param_hex_2_v1" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_hex_2"/><field name="date_from">1900-01-01</field><field name="value">0.35</field></record>

        <record id="param_hex_feriados" model="hr.rule.parameter">
            <field name="name">Recargo Horas extras Feriados (%)</field><field name="code">l10n_pe_horas_extras_feriados</field>
        </record>
        <record id="param_hex_feriados_v1" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_hex_feriados"/><field name="date_from">1900-01-01</field><field name="value">1.00</field></record>

        <!-- ========================================================== -->
        <!-- SISTEMA DE PENSIONES (SNP Y SPP)                           -->
        <!-- ========================================================== -->
        <record id="param_snp" model="hr.rule.parameter">
            <field name="name">SNP Aporte (%)</field><field name="code">l10n_pe_snp</field>
        </record>
        <record id="param_snp_v1" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_snp"/><field name="date_from">1900-01-01</field><field name="value">0.13</field></record>
        
        <!-- Para SPP (AFP), cada AFP tiene 3 componentes. Estos son solo los contenedores. -->
        <!-- Los valores reales deberían gestionarse en un modelo más complejo o con múltiples parámetros. -->
        <record id="param_spp_integra" model="hr.rule.parameter"><field name="name">SPP Integra</field><field name="code">l10n_pe_spp_21</field></record>
        <record id="param_spp_profuturo" model="hr.rule.parameter"><field name="name">SPP Profuturo</field><field name="code">l10n_pe_spp_23</field></record>
        <record id="param_spp_prima" model="hr.rule.parameter"><field name="name">SPP Prima</field><field name="code">l10n_pe_spp_24</field></record>
        <record id="param_spp_habitat" model="hr.rule.parameter"><field name="name">SPP Habitat</field><field name="code">l10n_pe_spp_25</field></record>

        <!-- ========================================================== -->
        <!-- RENTA DE QUINTA CATEGORÍA                                  -->
        <!-- ========================================================== -->
        <record id="param_renta_quinta" model="hr.rule.parameter">
            <field name="name">Tasas de Renta de Quinta Categoría</field><field name="code">l10n_pe_renta_quinta</field>
        </record>
        <!-- Nota: Este parámetro es un placeholder. La lógica de tramos (8%, 14%, etc.) debe ir en una regla salarial Python. -->

        <record id="param_renta_neta" model="hr.rule.parameter">
            <field name="name">Deducción Fija Renta (Nº de UITs)</field><field name="code">l10n_pe_utilidades_renta_neta_imponible</field>
        </record>
        <record id="param_renta_neta_v1" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_renta_neta"/><field name="date_from">1900-01-01</field><field name="value">7</field></record>

        <!-- ========================================================== -->
        <!-- UTILIDADES (% POR SECTOR)                                  -->
        <!-- ========================================================== -->
        <record id="param_util_pesca" model="hr.rule.parameter"><field name="name">Utilidades empresas pesqueras (%)</field><field name="code">l10n_pe_utilidades_pesqueras</field></record>
        <record id="param_util_pesca_v1" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_util_pesca"/><field name="date_from">1900-01-01</field><field name="value">0.10</field></record>
        
        <record id="param_util_agraria" model="hr.rule.parameter"><field name="name">Utilidades empresas agrarias (%)</field><field name="code">l10n_pe_utilidades_agrarias</field></record>
        <record id="param_util_agraria_v1" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_util_agraria"/><field name="date_from">1900-01-01</field><field name="value">0.05</field></record> <!-- Puede variar, ley agraria es especial -->
        
        <record id="param_util_telecom" model="hr.rule.parameter"><field name="name">Utilidades empresas telecomunicaciones (%)</field><field name="code">l10n_pe_utilidades_telecomunicaciones</field></record>
        <record id="param_util_telecom_v1" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_util_telecom"/><field name="date_from">1900-01-01</field><field name="value">0.10</field></record>
        
        <record id="param_util_industrial" model="hr.rule.parameter"><field name="name">Utilidades empresas industriales (%)</field><field name="code">l10n_pe_utilidades_industriales</field></record>
        <record id="param_util_industrial_v1" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_util_industrial"/><field name="date_from">1900-01-01</field><field name="value">0.10</field></record>
        
        <record id="param_util_mineria" model="hr.rule.parameter"><field name="name">Utilidades empresas mineras (%)</field><field name="code">l10n_pe_utilidades_mineras</field></record>
        <record id="param_util_mineria_v1" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_util_mineria"/><field name="date_from">1900-01-01</field><field name="value">0.08</field></record>
        
        <record id="param_util_comercio" model="hr.rule.parameter"><field name="name">Utilidades comercio y restaurantes (%)</field><field name="code">l10n_pe_utilidades_comercio_y_restaurantes</field></record>
        <record id="param_util_comercio_v1" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_util_comercio"/><field name="date_from">1900-01-01</field><field name="value">0.08</field></record>
        
        <record id="param_util_otras" model="hr.rule.parameter"><field name="name">Utilidades otras actividades (%)</field><field name="code">l10n_pe_utilidades_otras_actividades</field></record>
        <record id="param_util_otras_v1" model="hr.rule.parameter.version"><field name="parameter_id" ref="param_util_otras"/><field name="date_from">1900-01-01</field><field name="value">0.05</field></record>
        
    </data>
</odoo>