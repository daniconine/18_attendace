<!-- mstech_payroll_extend/data/hr_payroll_structure_data.xml -->
<odoo>
    <data noupdate="0">
        <!-- ========================================================== -->
        <!-- ESTRUCTURAS SALARIALES PARA PERÚ                           -->
        <!-- ========================================================== -->

        <!-- 1. Estructura para Nómina Mensual / Quincenal -->
        <record id="struct_monthly_pe" model="hr.payroll.structure">
            <field name="name">PE: Nómina Mensual/Quincenal</field>
            <field name="code">PE_MENSUAL_QUINCENAL</field>
            <field name="type_id" ref="hr_contract.structure_type_employee"/>
            <field name="parent_id" eval="False"/>
            <!-- Reglas a incluir -->
            <field name="rule_ids" eval="[
                (6, 0, [
                    ref('rule_remuneracion_basica'),
                    ref('rule_desc_inasistencias'),
                    ref('rule_ded_tardanzas'),
                    ref('rule_asignacion_familiar'),
                    ref('rule_horas_extras_25'),
                    ref('rule_horas_extras_35'),
                    ref('rule_feriado_trabajado'),
                    ref('rule_alimentacion_principal'),
                    ref('rule_movilidad_libre'),
                    ref('rule_bonos'),
                    ref('rule_comisiones'),
                    ref('rule_gratificacion'),
                    ref('rule_gross_pe'),
                    ref('rule_snp'),
                    ref('rule_spp'),
                    ref('rule_spp_aporte'), ref('rule_spp_prima'), ref('rule_spp_comision'),
                    ref('rule_renta_quinta_bruta_anual'),
                    ref('rule_renta_quinta_impuesto_anual'),
                    ref('rule_renta_quinta'),
                    ref('rule_descuento_eps'),
                    ref('rule_descuento_judicial'),
                    ref('rule_descuento_adelanto'),
                    ref('rule_descuento_prestamo'),
                    ref('rule_net_pe'),
                    ref('rule_aporte_sis'),
                    ref('rule_essalud_aporte'),
                    ref('rule_aporte_eps'),
                    ref('rule_aporte_sctr_salud'), ref('rule_aporte_sctr_pension'),
                    ref('rule_prov_cts'), ref('rule_prov_gratificacion'), ref('rule_prov_vacaciones')
                ])
            ]"/>
        </record>

        <!-- 2. Estructura para Pago de Vacaciones -->
        <record id="struct_vacation_pe" model="hr.payroll.structure">
            <field name="name">PE: Vacaciones</field>
            <field name="code">PE_VACACIONES</field>
            <field name="type_id" ref="hr_contract.structure_type_employee"/>
            <field name="parent_id" eval="False"/>
            <field name="rule_ids" eval="[
                (6, 0, [
                    ref('rule_remuneracion_vacacional')
                ])
            ]"/>
            <!-- # Se podrían añadir descuentos de ley si aplica -->
        </record>

        <!-- 3. Estructura para Pago de CTS -->
        <record id="struct_cts_pe" model="hr.payroll.structure">
            <field name="name">PE: CTS</field>
            <field name="code">PE_CTS</field>
            <field name="type_id" ref="hr_contract.structure_type_employee"/>
            <field name="parent_id" eval="False"/>
            <field name="rule_ids" eval="[
                (6, 0, [
                    ref('rule_cts_trunca')
                ])
            ]"/>
            <!-- 
            # Reutilizamos la de liquidación
            # La regla de CTS para pago es compleja, usualmente un input
            -->
        </record>
        
        <!-- 4. Estructura para Pago de Gratificación -->
        <record id="struct_gratificacion_pe" model="hr.payroll.structure">
            <field name="name">PE: Gratificación</field>
            <field name="code">PE_GRATIFICACION</field>
            <field name="type_id" ref="hr_contract.structure_type_employee"/>
            <field name="parent_id" ref="struct_monthly_pe"/>
            <field name="rule_ids" eval="[
                (6, 0, [
                    ref('rule_gratificacion'),
                    ref('rule_bono_extraordinario')
                ])
            ]"/>
            <!-- # Se podrían añadir descuentos de ley como Renta de 5ta o retención judicial -->
        </record>

        <!-- 5. Estructura para Liquidación de Beneficios Sociales -->
        <record id="struct_liquidation_pe" model="hr.payroll.structure">
            <field name="name">PE: Liquidación</field>
            <field name="code">PE_LIQUIDACION</field>
            <field name="type_id" ref="hr_contract.structure_type_employee"/>
            <field name="parent_id" eval="False"/>
            <field name="rule_ids" eval="[
                (6, 0, [
                    ref('rule_cts_trunca'),
                    ref('rule_vacaciones_truncas'),
                    ref('rule_gratificaciones_proporcionales'),
                    ref('rule_bono_extra_proporcional')
                ])
            ]"/>
            <!-- # Aquí también irían los descuentos pendientes -->
        </record>

        <!-- 6. Estructura para Pago de Utilidades -->
        <record id="struct_utilities_pe" model="hr.payroll.structure">
            <field name="name">PE: Utilidades</field>
            <field name="code">PE_UTILIDADES</field>
            <field name="type_id" ref="hr_contract.structure_type_employee"/>
            <field name="parent_id" eval="False"/>
            <field name="rule_ids" eval="[
                (6, 0, [
                    ref('rule_utilidades_pre_declaracion'),
                    ref('rule_utilidades_post_declaracion')
                ])
            ]"/>
            <!-- # Y la regla de Renta de 5ta sobre utilidades -->
        </record>

    </data>
</odoo>