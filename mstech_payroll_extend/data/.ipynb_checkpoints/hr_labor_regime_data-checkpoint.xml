<!-- mstech_payroll_extend/data/hr_labor_regime_data.xml -->
<odoo>
    <data noupdate="0">
        <!-- =============================================== -->
        <!-- ➤ Regímenes Generales y MYPE                    -->
        <!-- =============================================== -->

        <record id="regime_general_728" model="hr.labor.regime.pe">
            <field name="name">Privado General - D.L. N.º 728</field>
            <field name="code">728</field>
            <field name="plame_code">01</field>
            <field name="annual_vacation_days">30</field>
        </record>

        <record id="regime_small_company" model="hr.labor.regime.pe">
            <field name="name">Pequeña Empresa (REMYPE)</field>
            <field name="code">MYPE_PEQUEÑA</field>
            <field name="plame_code">17</field>
            <field name="annual_vacation_days">15</field>
        </record>

        <record id="regime_micro_company" model="hr.labor.regime.pe">
            <field name="name">Microempresa (REMYPE)</field>
            <field name="code">MYPE_MICRO</field>
            <field name="plame_code">16</field>
            <!-- Nota: La normativa para microempresas no obliga a vacaciones remuneradas como tal, 
                 pero se puede pactar. 15 es un valor común de referencia en caso de acuerdo. 
                 Si no aplica, se puede poner 0. -->
            <field name="annual_vacation_days">15</field>
        </record>

        <!-- =============================================== -->
        <!-- ➤ Regímenes Especiales                          -->
        <!-- =============================================== -->
        
        <record id="regime_construction" model="hr.labor.regime.pe">
            <field name="name">Construcción Civil</field>
            <field name="code">CONST_CIVIL</field>
            <field name="plame_code">21</field>
            <field name="receives_gratification">False</field>
            <!-- Nota: En construcción civil, las vacaciones son un % del jornal básico
                 y se pagan semanalmente. Para fines de saldo, 30 es el equivalente anual. -->
            <field name="annual_vacation_days">30</field>
        </record>

        <record id="regime_agrario" model="hr.labor.regime.pe">
            <field name="name">Agrario y de Riego (Ley 31110)</field>
            <field name="code">AGRO</field>
            <field name="plame_code">26</field>
            <field name="receives_gratification">False</field>
            <!-- Nota: Las vacaciones están incluidas en la Remuneración Diaria Agraria (RDA),
                 pero el derecho al descanso físico es de 30 días. Para control de saldo, usamos 30. -->
            <field name="annual_vacation_days">30</field>
        </record>

        <record id="regime_home_worker" model="hr.labor.regime.pe">
            <field name="name">Trabajadores del Hogar (Ley 31047)</field>
            <field name="code">HOGAR</field>
            <field name="plame_code">99</field>
            <field name="annual_vacation_days">30</field>
        </record>

        <record id="regime_part_time" model="hr.labor.regime.pe">
            <field name="name">Tiempo Parcial (Part-Time)</field>
            <field name="code">PART_TIME</field>
            <field name="plame_code">99</field>
            <field name="receives_gratification">False</field>
            <!-- Nota: Los trabajadores a tiempo parcial (menos de 4h diarias en promedio)
                 no tienen derecho a vacaciones pagadas por ley, solo al descanso físico. -->
            <field name="annual_vacation_days">0</field>
        </record>
        
        <record id="regime_foreign_artist" model="hr.labor.regime.pe">
            <field name="name">Artistas Extranjeros</field>
            <field name="code">ART_EXT</field>
            <field name="plame_code">99</field>
            <field name="receives_gratification">False</field>
            <field name="annual_vacation_days">30</field>
        </record>

        <!-- =============================================== -->
        <!-- ➤ Regímenes del Sector Público                  -->
        <!-- =============================================== -->

        <record id="regime_cas" model="hr.labor.regime.pe">
            <field name="name">Régimen CAS - D.L. N.º 1057</field>
            <field name="code">1057</field>
            <field name="plame_code">15</field>
            <field name="annual_vacation_days">30</field>
        </record>

        <record id="regime_public_career" model="hr.labor.regime.pe">
            <field name="name">Carrera Pública - D.L. N.º 276</field>
            <field name="code">276</field>
            <field name="plame_code">02</field>
            <field name="annual_vacation_days">30</field>
        </record>
        
        <record id="regime_civil_service" model="hr.labor.regime.pe">
            <field name="name">Servicio Civil (SERVIR)</field>
            <field name="code">SERVIR</field>
            <field name="plame_code">22</field>
            <field name="annual_vacation_days">30</field>
        </record>

    </data>
</odoo>