<!-- mstech_payroll_extend/data/cron_data.xml -->
<odoo>
    <data noupdate="0">
        <record id="cron_accrue_annual_vacation" model="ir.cron">
            <field name="name">Planilla PE: Devengo Anual de Vacaciones</field>
            <field name="model_id" ref="hr_contract.model_hr_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_accrue_annual_vacation()</field>
            <field name="user_id" ref="base.user_root"/>
