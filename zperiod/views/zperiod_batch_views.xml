<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_zperiod_batch_form" model="ir.ui.view">
        <field name="name">zperiod.batch.form</field>
        <field name="model">zperiod.batch</field>
        <field name="arch" type="xml">
            <form string="Lote de Períodos">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Fechas">
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_zperiod_batch_tree" model="ir.ui.view">
        <field name="name">zperiod.batch.list</field>
        <field name="model">zperiod.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
            </list>
        </field>
    </record>

    <record id="action_zperiod_batch" model="ir.actions.act_window">
        <field name="name">Lotes de Periodos</field>
        <field name="res_model">zperiod.batch</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer lote de periodos aquí.
            </p>
        </field>
    </record>
</odoo>