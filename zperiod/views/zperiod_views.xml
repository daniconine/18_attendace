<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_zperiod_tree" model="ir.ui.view">
        <field name="name">zperiod.list</field>
        <field name="model">zperiod</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'open'"
                    decoration-success="state == 'closed'"
                    decoration-danger="state == 'cancel'">

                <field name="name"/>
                <field name="employee_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="days_vacations"/>
                <field name="days_permissions"/>
                <field name="days_attended"/>
                <field name="days_unattended"/>
                <field name="diff_attendance_total" widget="float_time"/>
                <field name="late_min_total"/>
                <field name="hrs_total" widget="float_time"/>
                <field name="state" widget="badge"
                        decoration-info="state == 'open'"
                        decoration-success="state == 'closed'"
                        decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_zperiod_form" model="ir.ui.view">
        <field name="name">zperiod.form</field>
        <field name="model">zperiod</field>
        <field name="arch" type="xml">
            <form string="Periodo de Empleado">
                <header>
                    <button name="action_actualizar" string="Actualizar Asistencias" type="object" 
                            class="btn-outline-danger" invisible="state in ['closed', 'cancel']"/>               
                
            
                    <button name="action_cancel" string="Cancelar" type="object" 
                            invisible="state in ['closed', 'cancel']"/>
                    
                    <field name="state" widget="statusbar" statusbar_visible="open,closed,cancel"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group string="Datos Principales">
                        <group name="main_info" >
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="batch_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_start" readonly="state != 'draft'"/>
                            <field name="date_end" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Resumen de Asistencias">
                            <group>
                                <field name="days_attended"/>
                                <field name="days_unattended"/>
                                
                                <field name="diff_attendance_total" widget="float_time"/>
                                <field name="permiso_late_total"/>
                                <field name="late_min_total"/>
                                <field name="days_vacations"/>
                                <field name="days_permissions"/>
                                <field name="days_leave_permissions"/>
                                <field name="days_subsidies"/>
                                <field name="is_locked" groups="hr.group_hr_manager" widget="boolean_toggle"/>
                            </group>
                            
                            <group>
                                <field name="hrs_total" widget="float_time" class="fw-bold text-primary"/>

                                <div groups="zleave.group_boss,zleave.group_hr_manager" colspan="2" class="mt-2">
                                                                       

                                    <group col="2" class="mt-0">
                                        <field name="hrs_25" widget="float_time" invisible="hrs_25 == 0"/>
                                        <field name="hrs_35" widget="float_time" invisible="hrs_35 == 0"/>
                                        <field name="hrs_100" widget="float_time" 
                                            invisible="hrs_100 == 0" 
                                            class="text-danger fw-bold"/>
                                        <field name="hrs_200" widget="float_time" 
                                            invisible="hrs_200 == 0" 
                                            class="text-danger fw-bold"/>
                                    </group>
                                </div>
                            </group>

                    </group>
                    
                    <separator colspan="4"/>
                    <div class="oe_clear"/> 

                    <notebook>
                        <page string="Hoja de Tiempo" name="distribution">
                            <div class="alert alert-info p-3 mt-2" style="border-left: 5px solid #004085;">
                                <h4 class="alert-heading font-weight-bold">
                                    <i class="fa fa-clock-o mr-2"/> Registro de Dedicación Analítica
                                </h4>
                                <p class="mb-0">
                                    Indique el porcentaje de dedicación por centro de costo administrativo o 
                                    cuenta analítica administrativa (CCA) <br/>
                                    <strong>La suma debe ser exactamente 100%.</strong>
                                </p>
                            </div>
                            <div style="background-color:#f8f9fa; padding:12px; border-radius:8px;">
                                <div class="card-body p-2">
                                    <field name="segment_line_ids" context="{'default_period_id': id}">
                                        <list editable="bottom">
                                            <field name="plan_id" />
                                            <field name="analytic_account_id" domain="[('plan_id', '=', plan_id)]"/>                                    
                                            <field name="note"/>
                                            <field name="percentage" sum="Total %"/>
                                        </list>
                                    </field>
                                </div>
                            </div>
                        </page>

                        <page string="Bonos" name="bonus_page">
                            <div class="h5 bg-light p-2 border-bottom">
                                <i class="fa fa-gift mr-2 text-primary"/> Bonos Asignados
                            </div>
                            
                            <div style="background-color:#f8f9fa; padding:12px; border-radius:8px;">
                                <field name="bonus_ids" context="{'default_employee_id': employee_id, 'default_period_id': id}">
                                    <list editable="bottom">
                                        <field name="employee_id"/>
                                        <field name="date"/>
                                        <field name="analytic_account_id"/>
                                        <field name="note"/>
                                        <field name="amount" sum="Total Bonos"/>
                                        <field name="currency_id" column_invisible="True"/>
                                    </list>
                                </field>
                            </div>   
                        </page>

                        <page string="Comisiones" name="commissions_page">
                            <div class="h5 bg-light p-2 border-bottom">
                                <i class="fa fa-money mr-2 text-success"/> Comisiones del Periodo
                            </div>

                            <div style="background-color:#f8f9fa; padding:12px; border-radius:8px;">
                                <field name="commission_ids" context="{'default_employee_id': employee_id, 'default_period_id': id}">
                                    <list editable="bottom">
                                        <field name="employee_id"/>
                                        <field name="date"/>
                                        <field name="analytic_account_id"/>
                                        <field name="note"/>
                                        <field name="amount" sum="Total Comisiones"/>
                                        <field name="currency_id" column_invisible="True"/>
                                    </list>
                                </field>
                            </div>
                        </page>

                        <page string="Dictado de Clases" name="classes">
                            <div class="h5 bg-light p-2 border-bottom">
                                <i class="fa fa-graduation-cap mr-2 text-info"/> Registro de Horas de Clase
                            </div>
                            <div style="background-color:#f8f9fa; padding:12px; border-radius:8px;">
                                <field name="class_line_ids" context="{'default_period_id': id}">
                                    <list editable="bottom">
                                        <field name="employee_id"/>
                                        <field name="date"/>
                                        <field name="analytic_account_id"/>
                                        <field name="note"/>
                                        <field name="hours" sum="Total Horas"/>
                                        <field name="amount" sum="Total Monto"/>
                                        <field name="currency_id" column_invisible="True"/>
                                    </list>
                                </field>
                            </div>
                        </page>
                    </notebook>


                </sheet>
                
                
                <!-- CHATTER -->
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                    <field name="activity_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <record id="view_zperiod_search" model="ir.ui.view">
        <field name="name">zperiod.search</field>
        <field name="model">zperiod</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Mes" name="group_month" context="{'group_by': 'month'}"/>
                    <filter string="Empleado" name="group_employee" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_zperiod" model="ir.actions.act_window">
        <field name="name">Periodos Mensuales</field>
        <field name="res_model">zperiod</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_zperiod_search"/>
        <field name="context">{
            'search_default_group_month': 1}</field>
            
    </record>
</odoo>