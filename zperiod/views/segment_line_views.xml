<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- VISTA DE LISTA -->
        <record id="view_zperiod_segment_line_list" model="ir.ui.view">
            <field name="name">zperiod.segment.line.list</field>
            <field name="model">zperiod.segment.line</field>
            <field name="arch" type="xml">
                <list editable="bottom" string="Líneas de Segmentación">
                    <field name="period_id"/>
                    <field name="plan_id"/>
                    <field name="analytic_account_id"/>
                    <field name="percentage"/>
                    <field name="note"/>
                </list>
            </field>
        </record>

        <!-- VISTA DE FORMULARIO -->
        <record id="view_zperiod_segment_line_form" model="ir.ui.view">
            <field name="name">zperiod.segment.line.form</field>
            <field name="model">zperiod.segment.line</field>
            <field name="arch" type="xml">
                <form string="Línea de Segmentación">
                    <sheet>
                        <group>
                            <field name="period_id"/>
                        </group>
                        <group>
                            <field name="plan_id"/>
                            <field name="analytic_account_id"/>
                            <field name="percentage"/>
                            <field name="note"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ACCIÓN PARA ABRIR LA VISTA -->
        <record id="action_zperiod_segment_line" model="ir.actions.act_window">
            <field name="name">Líneas de Segmentación</field>
            <field name="res_model">zperiod.segment.line</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'group_by': ['year', 'month']}</field>
            <field name="view_id" eval="False"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Aquí puede administrar las líneas de segmentación de cada período.
                </p>
            </field>
        </record>

        
    </data>
</odoo>