<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
    <record id="hr_work_entry_type_view_form" model="ir.ui.view">
        <field name="name">hr.work.entry.type.form.mstech.hr</field>
        <field name="model">hr.work.entry.type</field>
        <field name="inherit_id" ref="hr_work_entry.hr_work_entry_type_view_form"/>
        <field name="priority">25</field>
        <field name="arch" type="xml"><data>
            <xpath expr="//group[@name='main_group']" position="after">
                <group>
                    <group string="Asignación automática de entradas" class="o_form_fw_labels">
                        <field name="entry_category"/>
                        <field name="min_duration" invisible="not entry_category"/>
                    </group>
                    <group string="Cálculo del importe" class="o_form_fw_labels">
                        <field name="rule_param_id"/>
                    </group>
                </group>
            </xpath>
</data></field>
    </record>
</data></odoo>
